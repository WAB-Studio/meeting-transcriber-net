{
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "claude-in-chrome": "off",
    "schedule": "off",
    "loop": "off",
    "keybindings-help": "off",
    "update-config": "off",
    "fewer-permission-prompts": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "claude-api": "off",
    "init": "off",
    "run": "off",
    "run-day": "off",
    "grill": "off"
  },
  "permissions": {
    "allow": [
      "PowerShell(python:*)",
      "Bash(python:*)",
