{
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "claude-in-chrome": "off",
    "schedule": "off",
    "loop": "off",
    "keybindings-help": "off",
    "update-config": "off",
    "fewer-permission-prompts": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "claude-api": "off",
    "init": "off",
    "run": "off",
    "run-day": "off",
    "grill": "off"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",

    "deny": [
      "Read(//wsl.localhost/**)",
      "Read(//wsl$/**)",
      "Read(**/*.wav)",
      "Read(**/*.m4a)",
      "Read(**/*.mp3)",
      "Edit(**/deepgram.json)",

      "Read(//c/Users/pc/.ssh/**)",
      "Read(//c/Users/pc/.config/**)",
      "Read(//c/Users/pc/.claude/.credentials.json)",
      "Read(//c/Users/pc/.aws/**)",

      "Edit(//c/Users/pc/.claude/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/orchestrator/settings.json)",
      "Edit(.claude/orchestrator/*.ps1)",
      "Edit(.claude/orchestrator/*.psm1)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",

      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git remote:*)",
      "PowerShell(git remote:*)",
      "Bash(git push --delete:*)",
      "PowerShell(git push --delete:*)",

      "Bash(gh auth:*)",
      "PowerShell(gh auth:*)",
      "Bash(gh secret:*)",
      "PowerShell(gh secret:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge:*)"
    ],

    "allow": [
      "PowerShell(python:*)",
      "Bash(python:*)",
      "PowerShell(codex exec:*)",
      "Bash(codex exec:*)",
      "Read(//c/Users/pc/.codex/**)",
      "Read(//c/Users/pc/.claude/skills/**)",

      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(printenv:*)",
      "Bash(tasklist:*)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(timeout:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Select-Object:*)",
      "PowerShell(Where-Object:*)",
      "PowerShell(ForEach-Object:*)",
      "PowerShell(Sort-Object:*)",
      "PowerShell(Measure-Object:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-Process:*)",
      "PowerShell(Out-String:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(codex:*)",
      "Bash(codex:*)",
      "PowerShell(Get-Command:*)",
      "Bash(command:*)",
      "Bash(sed:*)"
    ]
  }
}
