<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows because the audio engine is: this project composes WASAPI capture with the
         corpus, so it inherits the floor the engine declares rather than choosing one. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>MeetingTranscriber.Recording</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Composing these two is the reason this project exists. Neither of them may reference the
         other: SQLite would drag WASAPI into rendering a transcript, and the audio engine would
         stop being provable without a corpus. -->
    <ProjectReference Include="..\MeetingTranscriber.Audio\MeetingTranscriber.Audio.csproj" />
    <ProjectReference Include="..\MeetingTranscriber.Domain\MeetingTranscriber.Domain.csproj" />
    <ProjectReference Include="..\MeetingTranscriber.Infrastructure\MeetingTranscriber.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Producing what a meeting's transcription is read from, which nobody is ever asked about and
       so has to happen without a prompt. It is here rather than beside the window because what a
       launch owes the corpus is decided in one ordered list, and this is the only project that may
       hold a rule and can see both the sweep and the renders: the CLI sees both and holds no rule
       of its own, the app has no probe a build agent could run, and Processing may not see this
       side without WASAPI arriving under it.

       The edge is for WhatALaunchOwes and nothing else. Everything else in this project is the
       audio engine composed with the corpus, and a recording rule reaching for a transcript has
       taken a wrong turn — the reference makes that compile, which is not the same as allowing it. -->
  <ItemGroup>
    <ProjectReference Include="..\MeetingTranscriber.Processing\MeetingTranscriber.Processing.csproj" />
  </ItemGroup>

</Project>
