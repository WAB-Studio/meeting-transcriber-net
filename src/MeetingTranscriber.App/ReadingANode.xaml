<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeetingTranscriber.App.ReadingANode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         The fourth kind of screen the product has: every other one is about one meeting or about
         the list of them, and this one is about a thing several meetings hang off. Reached from a
         meeting's own filing chip and never from anywhere else — docs/design.md §Historia is the
         authority this was built from.

         What is drawn is built in the code-behind because which cards exist, how many things are
         in each and where the path ends are answers, not a layout — the same rule
         ReadingAMeeting's cards are built under. The look stays here, as the styles below. -->

    <Grid x:Name="Root" RowSpacing="12">
        <Grid.Resources>
            <Style x:Key="NodeCard" TargetType="Border" BasedOn="{StaticResource Card}" />

            <!-- A section of one meeting's story, at the rank docs/design.md §Type gives one. -->
            <Style x:Key="MeetingHeadingText" TargetType="TextBlock" BasedOn="{StaticResource SectionText}" />

            <Style x:Key="MeetingDateText" TargetType="TextBlock" BasedOn="{StaticResource DataText}" />

            <!-- The heading is itself the press that opens the meeting, for the same reason
                 TheRowItself exists: a row you press without a control of its own. -->
            <Style x:Key="MeetingHeadingButton" TargetType="Button" BasedOn="{StaticResource TheRowItself}" />

            <!-- What was said, in the AI's own words. -->
            <Style x:Key="Said" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SaidAt" TargetType="TextBlock" BasedOn="{StaticResource DataText}" />

            <!-- The three sections' bullets, docs/design.md §Historia's own colours: olive for a
                 decision, pico for an open question, the rule's own grey for an action — the same
                 pair Reunion draws and the same meaning here. -->
            <Style x:Key="BulletDecision" TargetType="Ellipse">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Fill" Value="{StaticResource OliveBrush}" />
            </Style>

            <Style x:Key="BulletQuestion" TargetType="Ellipse" BasedOn="{StaticResource BulletDecision}">
                <Setter Property="Fill" Value="{StaticResource PeakBrush}" />
            </Style>

            <Style x:Key="BulletAction" TargetType="Ellipse" BasedOn="{StaticResource BulletDecision}">
                <Setter Property="Fill" Value="{StaticResource LineBrush}" />
            </Style>

            <!-- The path, as pills. Local keys naming Olivo's own, the way every other key on this
                 screen does — `Chrome` reads this screen's own dictionary and never Olivo's
                 directly, so a screen that named Olivo's key by its own name would throw the
                 moment the path drew. -->
            <Style x:Key="LastNode" TargetType="Border" BasedOn="{StaticResource Pill}" />

            <Style x:Key="PathNode" TargetType="Button" BasedOn="{StaticResource PillButton}" />

            <Style x:Key="PathPillSays" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />

            <Style x:Key="NothingSaidYet" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
            </Style>

            <Style x:Key="ThereIsMore" TargetType="TextBlock" BasedOn="{StaticResource DataText}">
                <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header. On the root grid and never inside the scrolling body below, which is
             where the meeting screen's own status line sits too — LiveRegionTests sweeps every
             screen for a line that travels off it or starts inside something collapsed. -->
        <StackPanel Grid.Row="0" Spacing="10">
            <Button
                x:Name="BackButton"
                HorizontalAlignment="Left"
                Style="{StaticResource ButtonAtTheMargin}"
                Click="OnBack"
                Content="{x:Bind In(loc:UiTexts.BackToTheMeeting)}" />

            <!-- The path down the tree, built in the code-behind: every node but the last is the
                 press that reads that node's own story, and the last is shown rather than
                 pressed — you are already reading it. -->
            <local:WrappingRow x:Name="ThePath" HorizontalGap="6" VerticalGap="6" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    Style="{StaticResource DataText}"
                    Text="{x:Bind In(loc:UiTexts.WhatWasSaidAboutThis)}" />
                <TextBlock x:Name="CountText" Style="{StaticResource DataText}" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- The body: one card per meeting, oldest first, because a history is read forward.
             There is no player and no transcript here — the minute on each thing says which
             meeting to open to hear it, and the transcript unfolds there. -->
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="TheStory" Spacing="12" />
        </ScrollViewer>
    </Grid>
</UserControl>
