<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeetingTranscriber.App.AddingSomebody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonClick="OnSomebodyNamed"
    PrimaryButtonText="{x:Bind In(loc:UiTexts.Save)}"
    CloseButtonText="{x:Bind In(loc:UiTexts.Cancel)}">

    <!-- Adding a person, and correcting one — the second and last dialogue `docs/design.md`
         §Notices allows. Two screens open it now, `ClassifyingAMeeting` and `SayingWhoIsWho`, and
         it does two jobs and is not two dialogues: adding somebody and correcting the name of
         somebody already there are the same form with one field.

         Its title is set where it is opened rather than bound here, because it is one of two. -->
    <StackPanel Spacing="12" MinWidth="320">
        <TextBox
            x:Name="TheirNameBox"
            Style="{StaticResource TypedField}"
            TextChanged="OnTheirNameTyped"
            Header="{x:Bind In(loc:UiTexts.NameOfAPerson)}" />

        <!-- The organization is said beside the picker and never as a header on it: a pill has no
             part to draw one, so a `Header` here binds, builds green and shows nothing at all. -->
        <StackPanel x:Name="TheirOrganizationLine" Spacing="6">
            <TextBlock
                Style="{StaticResource BodyText}"
                Text="{x:Bind In(loc:UiTexts.Organization)}" />
            <ComboBox x:Name="TheirOrganization" Style="{StaticResource DropDown}" />
        </StackPanel>

        <!-- Optional, and empty means what `Affiliation` already means by no start: as far back as
             this corpus goes. A year and not a date, because a period on a person is read against
             the meeting's own year and nothing finer. -->
        <TextBox
            x:Name="TheirYearBox"
            Style="{StaticResource TypedField}"
            MaxLength="4"
            Header="{x:Bind In(loc:UiTexts.From)}" />

        <TextBlock
            x:Name="DialogueStatusText"
            Style="{StaticResource BodyText}"
            Foreground="{StaticResource PeakBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
