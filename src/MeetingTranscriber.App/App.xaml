<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MeetingTranscriber.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App">
    <!-- `RequestedTheme` is left unset on purpose: the application follows the theme Windows is set
         to, and follows a switch made while it is open, because leaving it unset is what makes the
         platform track it. Olivo carries both palettes in its ThemeDictionaries and every brush a
         screen names is a ThemeResource, so what follows the theme is the whole window and not only
         the platform's own controls. -->

    <!-- Olivo is merged after the platform's own dictionary and never before it. Every control
         style in it is `BasedOn` one of the platform's, so focus, the keyboard and the automation
         peer stay the platform's and only what is drawn is Olivo's — and a merge in the other
         order resolves those lookups against nothing. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Olivo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
