<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeetingTranscriber.App.MeetingsDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         The cards are built in the code-behind rather than templated here, and that is what makes
         a language change total: they are thrown away and made again out of the catalogue, so no
         card can be left holding the words it was born with. What each one looks like is still
         here, as the styles below, so the code-behind chooses a style and never a colour.

         What each card says and which of its buttons are live is not decided here either. Every
         one of them comes off an OwedWork, which is the one thing that answers that question and
         the one thing a build agent can run.

         A control and not a window: the meetings are the bottom half of the one screen the
         application opens on, and what is on them is read while a meeting is being recorded above.
         The header is the only thing here that is not about a meeting — it is what raises the list
         to the whole window and lowers it again, and it is in the same place either way. -->

    <Grid x:Name="Root" RowSpacing="8">
        <!-- Every style here is Olivo's, named from `docs/design.md` §Colour, §Type and §Controls.
             None of them chooses a value. What changed when the front door was drawn from Olivo is
             that these stopped being the platform's brushes standing in for a palette nothing had
             reached yet — and OlivoTests now fails the build over a value typed in here. -->
        <Grid.Resources>
            <Style x:Key="MeetingCard" TargetType="Border" BasedOn="{StaticResource Card}" />

            <Style x:Key="MeetingName" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The row is the thing you press to open the meeting, and the name is where the row
                 is pressed. `docs/design.md` left that open against the alternative — a third
                 button on every row — and this is the answer the same document's own button
                 grammar forces: a row lays its answers out in two places and holds nothing else,
                 so an open button would have to displace one of the two answers that cost money.
                 Making the name the press adds no control to the row at all.

                 It is a button and not a tapped border, because a border that responds to a press
                 is nothing to a keyboard and nothing to a screen reader. This is one focusable
                 thing whose automation name is the meeting's own name, which is also how a probe
                 reaches it. What it looks like is the name, which is what the style leaves it as. -->
            <Style x:Key="MeetingOpen" TargetType="Button" BasedOn="{StaticResource TheRowItself}" />

            <!-- A meeting nobody has named. It reads as the sentence it is rather than as a name,
                 which is the whole of ISC-165.1 on a row: the application has not thought of one
                 and is not pretending to. Quieter by ink and not by opacity — `docs/design.md`
                 gives three inks, and a faded one is a fourth grey nobody chose. -->
            <Style x:Key="MeetingUnnamed" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>

            <!-- When it was, how long it ran, what it occupies. Data, so the data rank: numbers
                 read against each other down the list rather than a sentence read once. -->
            <Style x:Key="MeetingWhen" TargetType="TextBlock" BasedOn="{StaticResource DataText}" />

            <Style x:Key="MeetingLine" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The one standing with money or data riding on it does not read as one more grey
                 caption. It is the only thing on this screen that stops on a person, and the whole
                 point of showing it is that somebody notices. It is louder by ink rather than by
                 weight, which is `docs/design.md` §And five things this application is not: never
                 hierarchy made only of bold. -->
            <Style x:Key="MeetingStoppedOnAPerson" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The act on the right of a row, and the normal rank rather than pico. A button that
                 opens the question is not the button that answers it: *Transcribir* and *Resumir*
                 cost nothing to press — they open the dialogue where the charge is agreed to — and
                 a list of twelve meetings with twelve orange buttons spends the colour that is
                 supposed to mean *this one costs money*. A row is tarjeta, so its buttons are papel
                 with a 1px rule. -->
            <Style x:Key="TakeTheStage" TargetType="Button" BasedOn="{StaticResource RowButtonOnCard}" />

            <!-- The two tints `docs/design.md` fixes, and the only thing that tells a row waiting
                 on the person from one the application is merely working on. Something waiting on
                 a decision is the decision tint; something lost or about to be is the attention
                 tint. Which is why the recording still running takes neither and sits on the card
                 surface with the meetings — `tarjeta`, in that document's own words: nothing about
                 it is waiting on anybody.

                 These were `SystemFillColorAttentionBackgroundBrush` and
                 `SystemFillColorCautionBackgroundBrush`, Windows' own two for the same two
                 meanings, because this application was not drawn from that palette yet and a pair
                 of hex values here would have been two more things for ISC-173 to find. ISC-173 is
                 this change, and they are now the palette's own under the keys every screen after
                 this one uses. -->
            <Style x:Key="WaitingOnADecision" TargetType="Border" BasedOn="{StaticResource WaitingOnADecisionCard}" />

            <Style x:Key="SomethingIsLost" TargetType="Border" BasedOn="{StaticResource SomethingIsLostCard}" />

            <!-- The 18px warning triangle that goes on the attention tint, and only there.
                 `docs/design.md` §Notices: something lost or about to be says what was observed
                 before what it means, and this mark is the part of that a reader takes in before
                 reading anything at all. The decision tint has none — something waiting on a
                 person is not something that went wrong, and a triangle on it would spend the one
                 mark that says something did.

                 Drawn on the artboard's own 24-unit geometry and scaled to 18, so the stroke stays
                 the weight that was drawn rather than the weight a re-typed path happened to give. -->
            <Style x:Key="SomethingIsLostMark" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource PeakBrush}" />
                <Setter Property="StrokeThickness" Value="1.9" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Data" Value="M12 4.6L21.2 19.4H2.8z M12 10.2v3.9 M12 16.9v.1" />
            </Style>

            <!-- The one press on this screen that loses something. It sits to the left of the left
                 one, past a gap, so it cannot be pressed by reflex — the margin is the gap, and it
                 is the whole difference between this and every other neutral button here. -->
            <Style x:Key="ItLosesSomething" TargetType="Button" BasedOn="{StaticResource RowButtonThatLosesSomething}" />

            <!-- The neutral one on the left: open it, see it, leave it as it was. Never filled,
                 always secondary ink, the same button on every screen with only the word changing. -->
            <Style x:Key="TheNeutralOne" TargetType="Button" BasedOn="{StaticResource RowButtonAtTheMargin}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header, which is the drawer's own control and sits in the same place whether the
             list is docked under the recording card or has the whole window. -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind In(loc:UiTexts.Meetings)}"
                Style="{StaticResource SectionText}" />

            <!-- What the list is waiting on. The artboard puts a bare count here and the
                 catalogue puts a sentence with a number in it, and the rank follows what the text
                 actually is: `docs/design.md` §Type says text never goes in mono and a number that
                 is part of a sentence is text. Whether this should be the artboard's bare count
                 instead is a question about the words, which is #182's and #199's. -->
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}" />

            <!-- Its words are set in the code-behind and not bound here, because they are the one
                 thing on this screen that says which of the two positions the drawer is in. -->
            <Button
                x:Name="OpennessButton"
                Grid.Column="2"
                Style="{StaticResource NormalButtonOnPaper}"
                Click="OnToggleOpenness" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Cards" Spacing="12" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Left">
            <!-- Said rather than left to be noticed. The rendered files are the one thing here
                 that will never be a press, so their not being a button is the screen's to explain
                 instead of looking like a control somebody lost. What it does not say is when they
                 appear: today they are produced by `rebuild` and `render` at the command line and
                 never by this application, so a caption about that would be a promise this screen
                 cannot keep.

                 There is no second caption here saying nothing is deleted until somebody chooses
                 it, and that is where somebody would put one. `docs/design.md` settled it on
                 2026-08-26, twenty minutes after the card that asked for it: nothing is deleted
                 until somebody chooses it, and saying so is the application reassuring the reader
                 about a thing it was never going to do. What says it instead is the row — a
                 recording sits there over as many starts as it takes, and *Descartar* is the only
                 thing that removes it. -->
            <TextBlock
                Text="{x:Bind In(loc:UiTexts.TheRenderedFilesAreNeverAskedAbout)}"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap"
                MaxWidth="640" />
            <TextBlock
                x:Name="MeetingsStatusText"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
