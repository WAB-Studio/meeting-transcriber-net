<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- A floor of Windows 11: capturing one process's audio does not exist before it, and this
         is what makes CA1416 speak up when something the floor does not support gets called. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>MeetingTranscriber.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only: it is the self-contained build that goes inside the MSIX. A packaged
         application cannot be left on AnyCPU, so the RID is fixed here rather than left to
         whichever platform MSBuild happened to be invoked with. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- What the screens say, and what language they say it in. -->
  <ItemGroup>
    <ProjectReference Include="..\MeetingTranscriber.Presentation\MeetingTranscriber.Presentation.csproj" />
  </ItemGroup>

  <!-- Recording a meeting: the audio engine composed with the corpus. It brings Audio,
       Infrastructure and Domain along with it, and it is the only edge this application needs —
       everything a screen decides lives on that side, where a build agent can run it. -->
  <ItemGroup>
    <ProjectReference Include="..\MeetingTranscriber.Recording\MeetingTranscriber.Recording.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!--
    `PackageIdentitySuffix` appends to <Identity Name> in the AppxManifest.xml the build writes, so
    one checkout can register a package of its own instead of taking the machine's one registration
    off whoever had it. Who sets it and what it buys them is docs/ui-probe.md: it is an agent
    driving the app's windows from a worktree beside other agents doing the same. Empty is the
    default and the whole build is then what it always was.

    It comes out of a file at the top of the checkout, untracked and named in .gitignore, and never
    off a command line. A worker cannot type it on every build: `dotnet build` over the solution is
    a step this repo requires on every pass, and one of those without the argument would poke the
    shared identity back into the manifest, leave the suffixed registration pointing at it, and put
    the checkout straight back into the collision this exists to end. A fact about a folder has to
    live in the folder. It is not in Package.appxmanifest for the mirror-image reason: that file is
    versioned, so a suffix there is an uncommitted edit sitting in every worktree, and a dirty tree
    stops the next worker's preflight.

    `AfterGenerateAppxManifest` is the Windows App SDK's own hook, and it is the one moment that
    works: the manifest exists by then, and the recipe, the payload and the registration are all
    still ahead. The name is composed from the source manifest rather than from the generated one,
    so the suffix goes on once however many times this runs — an incremental build leaves the
    manifest alone and this still finds the name it is meant to end at. It runs whether or not a
    suffix was asked for, and writes only when the file disagrees with the answer: deleting the
    file puts the identity back where writing it found it, and a build with no file writes nothing
    at all.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\PackageIdentity.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\PackageIdentity.props')" />

  <Target Name="SuffixThePackageIdentity" AfterTargets="AfterGenerateAppxManifest">
    <PropertyGroup>
      <_PackageIdentityQuery>/p:Package/p:Identity/@Name</_PackageIdentityQuery>
      <_PackageManifestNamespace>&lt;Namespace Prefix="p" Uri="http://schemas.microsoft.com/appx/manifest/foundation/windows10" /&gt;</_PackageManifestNamespace>
    </PropertyGroup>

    <!-- A transform and not %(AppxManifest.FullPath): batching over an empty item list skips the
         task without a word, and the identity read out of nothing is the empty string, which the
         poke below would then write into the manifest. -->
    <XmlPeek XmlInputPath="@(AppxManifest->'%(FullPath)')"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)">
      <Output TaskParameter="Result" PropertyName="_PackageIdentityInTheSource" />
    </XmlPeek>

    <Error Condition="'$(_PackageIdentityInTheSource)' == ''"
           Text="@(AppxManifest) has no &lt;Identity Name&gt;, so there is no name for the package identity to be built out of. The identity in $(FinalAppxManifestName) is left as the build wrote it." />

    <!-- Fifty is the maxLength the appx foundation schema puts on <Identity Name>, and a name over
         it is the one failure in this whole mechanism that says nothing: `Add-AppxPackage -Register`
         refuses the manifest without naming the reason, so the checkout stays registered to whatever
         it had before and every refusal after that is about the wrong folder. Catching it here is
         what turns that into a sentence. How much room the suffix has is asked of the source name
         rather than written down, because renaming the identity moves it. -->
    <PropertyGroup>
      <_MostCharactersInAPackageName>50</_MostCharactersInAPackageName>
      <_PackageIdentityWanted>$(_PackageIdentityInTheSource)$(PackageIdentitySuffix)</_PackageIdentityWanted>
    </PropertyGroup>

    <Error Condition="$(_PackageIdentityWanted.Length) &gt; $(_MostCharactersInAPackageName)"
           Text="PackageIdentitySuffix '$(PackageIdentitySuffix)' would make the package identity $(_PackageIdentityWanted), which is $(_PackageIdentityWanted.Length) characters. Windows caps a package name at $(_MostCharactersInAPackageName) and Add-AppxPackage refuses a longer one without saying why. $(_PackageIdentityInTheSource) leaves $([MSBuild]::Subtract($(_MostCharactersInAPackageName), $(_PackageIdentityInTheSource.Length))) characters for the suffix. The identity in $(FinalAppxManifestName) is left as the build wrote it - see docs/ui-probe.md." />

    <XmlPeek XmlInputPath="$(FinalAppxManifestName)"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)">
      <Output TaskParameter="Result" PropertyName="_PackageIdentityAsGenerated" />
    </XmlPeek>

    <XmlPoke Condition="'$(_PackageIdentityAsGenerated)' != '$(_PackageIdentityWanted)'"
             XmlInputPath="$(FinalAppxManifestName)"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)"
             Value="$(_PackageIdentityWanted)" />
  </Target>
</Project>