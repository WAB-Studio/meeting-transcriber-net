<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- A floor of Windows 11: capturing one process's audio does not exist before it, and this
         is what makes CA1416 speak up when something the floor does not support gets called. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>MeetingTranscriber.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only: it is the self-contained build that goes inside the MSIX. A packaged
         application cannot be left on AnyCPU, so the RID is fixed here rather than left to
         whichever platform MSBuild happened to be invoked with. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- The two faces, inside the package. `docs/design.md` says every text on every screen is set
       in Space Grotesk and every number that gets compared to another one in JetBrains Mono, so a
       machine that has this application has both of them and no screen falls back to anything.

       Both are under the SIL Open Font License 1.1, which permits bundling and redistributing them
       with software provided each copy carries the copyright notice and the licence — so the two
       `OFL.txt` files ship beside the fonts and are Content for that reason and not by accident.
       Neither font declares a Reserved Font Name and neither is modified here; only the file names
       were shortened, because the published names carry the `[wght]` of a variable axis and square
       brackets are a wildcard to MSBuild's own globber.

       Variable rather than one file per weight: Space Grotesk publishes no static SemiBold and
       three of the seven ranks are 600. -->
  <!--
    `CopyToOutputDirectory` and not `Content` alone, which is the difference between a font that is
    in the package and a font that loads. Content on its own indexes the file into `resources.pri`
    and puts nothing on disk: the layout this project builds has no `Assets` folder in it at all,
    and `ms-appx:///Assets/Fonts/...` has to reach a real file for DirectWrite to open one. The
    failure is silent at every level — the build says nothing, the resource resolves, and the screen
    renders whole in Segoe UI — so it was found by photographing the window and not by reading
    anything. The logos above have the same shape and get away with it because a dev layout's tiles
    are nobody's evidence.
  -->
  <ItemGroup>
    <Content Include="Assets\Fonts\SpaceGrotesk.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\JetBrainsMono.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\SpaceGrotesk-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- What the screens say, and what language they say it in. -->
  <ItemGroup>
    <ProjectReference Include="..\MeetingTranscriber.Presentation\MeetingTranscriber.Presentation.csproj" />
  </ItemGroup>

  <!-- Recording a meeting: the audio engine composed with the corpus. It brings Audio,
       Infrastructure, Domain and Processing along with it, and everything a screen decides lives on
       that side, where a build agent can run it. -->
  <ItemGroup>
    <ProjectReference Include="..\MeetingTranscriber.Recording\MeetingTranscriber.Recording.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <!--
      Never trimmed, in any configuration, and that is a decision rather than the template's
      default left alone. EF Core builds its model by reflecting over `CorpusDbContext` and its
      entity types, the SQLite provider resolves `SQLitePCLRaw` through a bundle that is found the
      same way, and the migrations in this assembly are discovered rather than referenced - none of
      which a trimmer can see. Nothing in this repository has ever run a Release publish, so a
      trimmed package would be handed to somebody as the first build that ever existed, and what it
      would fail on is the first query against their corpus. What trimming would buy is tens of
      megabytes against a corpus that holds gigabytes of audio nobody can record again. The day
      somebody wants it back, the thing to do first is run the trimmed package against a real
      corpus and read the warnings, not flip this line.

      The premise stops here and does not reach `PublishReadyToRun` above, which is equally
      unexercised and keeps its Debug/Release pair. What trimming does is delete code a trimmer
      cannot see reached; what ReadyToRun does is precompile code it keeps either way, so being
      wrong about it costs startup time and not a query.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      One `.msix`, not a bundle: there is one architecture and sideloading takes the package itself.
      Both were measured on 2026-09-11 and neither changes what today's build produces - the
      documented command lands exactly one signed `.msix` and no `.msixbundle` or `.msixupload`
      with these two lines deleted. They are here because of how the toolchain would fail if a
      default moved, and not because they are what makes it work: `PackagedAppTests` finds the
      package by looking for an `.msix` under `AppPackages`, so a build mode that produced a bundle
      instead would leave it finding nothing and all five facts would *skip*, green, saying nothing.
      A silent default is the one kind this card cannot survive, so the two that decide the shape
      of the output are written down rather than inherited.

      These two and not `GenerateAppxPackageOnBuild` or `AppxPackageSigningEnabled`, which stay on
      the command line in docs/packaging.md §3: putting either of those in this project - here or in
      `win-x64.pubxml`, which this csproj names in `<PublishProfile>` and which is therefore read by
      every build - makes `dotnet build` package, and it has no certificate. Measured, with what
      each one did, in the comment at the foot of `Properties\PublishProfiles\win-x64.pubxml`.
    -->
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>

  <!--
    `PackageIdentitySuffix` appends to <Identity Name>, so one checkout can register a package of
    its own instead of taking the machine's one registration off whoever had it. Who sets it and
    what it buys them is docs/ui-probe.md: it is an agent driving the app's windows from a worktree
    beside other agents doing the same. Empty is the default and the whole build is then what it
    always was.

    It comes out of a file at the top of the checkout, untracked and named in .gitignore, and never
    off a command line. A worker cannot type it on every build: `dotnet build` over the solution is
    a step this repo requires on every pass, and one of those without the argument would poke the
    shared identity back into the manifest, leave the suffixed registration pointing at it, and put
    the checkout straight back into the collision this exists to end. A fact about a folder has to
    live in the folder. It is not in Package.appxmanifest for the mirror-image reason: that file is
    versioned, so a suffix there is an uncommitted edit sitting in every worktree, and a dirty tree
    stops the next worker's preflight.

    Debug only, and that is a boundary rather than a convenience. The file is untracked, so a
    machine that once had a probe session on it would otherwise carry the suffix into every Release
    and every MSIX from then on, with nothing in the tree to show for it: a shipped package under a
    name nobody chose, with a family name and therefore a per-package data folder of its own. The
    product's identity is Package.appxmanifest's. This is a development-machine affordance for the
    one configuration the probe is registered from.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\PackageIdentity.props"
          Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\..\PackageIdentity.props')" />

  <PropertyGroup>
    <_PackageIdentityQuery>/p:Package/p:Identity/@Name</_PackageIdentityQuery>
    <_PackageManifestNamespace>&lt;Namespace Prefix="p" Uri="http://schemas.microsoft.com/appx/manifest/foundation/windows10" /&gt;</_PackageManifestNamespace>
    <_MostCharactersInAPackageName>50</_MostCharactersInAPackageName>
  </PropertyGroup>

  <!--
    The identity is settled before anything derives from it, and that is why this is two targets
    and not one. The manifest is not the only thing carrying the name: the SDK indexes resources.pri
    under it too, defaulting ProjectPriIndexName to the source identity in
    Microsoft.Windows.SDK.BuildTools.MSIX.Pri.targets, and makepri runs long before the manifest is
    generated. Suffixing only the manifest left a layout whose two halves disagreed — measured, not
    assumed: a build under `-s3probe` wrote `...-cb4-s3probe` into AppxManifest.xml while
    resources.pri still held `...-cb4` and had not been re-indexed at all. Windows 11 registered
    and ran that layout anyway, and the SDK's own comment says the two had to match before build
    19041, so it worked here by grace of the version rather than by design. A layout with one name
    in it costs nothing more than a layout with two.

    `_ValidatePresenceOfAppxManifestItems` is the hook because the PRI target depends on it: this
    runs inside that chain, so ProjectPriIndexName is already set when the SDK goes looking for it,
    and every guard below fires before makepri and before the manifest is written rather than after
    both of them.
  -->
  <Target Name="DecideThePackageIdentity" AfterTargets="_ValidatePresenceOfAppxManifestItems">
    <!-- A transform and not %(AppxManifest.FullPath): batching over an empty item list skips the
         task without a word, and the identity read out of nothing is the empty string. XmlPeek with
         no input fails on its own before the Error below is reached; the Error is for a manifest
         that is there and has no name in it. -->
    <XmlPeek XmlInputPath="@(AppxManifest->'%(FullPath)')"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)">
      <Output TaskParameter="Result" PropertyName="_PackageIdentityInTheSource" />
    </XmlPeek>

    <Error Condition="'$(_PackageIdentityInTheSource)' == ''"
           Text="@(AppxManifest) has no &lt;Identity Name&gt;, so there is no name for the package identity to be built out of." />

    <PropertyGroup>
      <_PackageIdentityWanted>$(_PackageIdentityInTheSource)$(PackageIdentitySuffix)</_PackageIdentityWanted>
    </PropertyGroup>

    <!-- Both halves of ST_PackageName, because both fail the same way. Fifty is its maxLength, and
         `Add-AppxPackage -Register` refuses a longer name without naming the reason: the checkout
         keeps whatever registration it had, and every refusal after that is a true sentence about
         the wrong folder. The character set is the half somebody reaches first — the doc invites a
         word of their own, and the schema excludes underscore and space from a name that otherwise
         looks fine. An underscore is worse than refused: it is the AUMID's own separator between
         the name and the publisher hash. \A and \z rather than ^ and $, because MSBuild does not
         trim property text — a props file somebody pretty-printed puts newlines inside the name,
         and $ would match before a trailing one. How much room the suffix has is subtracted from
         the source name rather than written down, because renaming the identity moves it. -->
    <Error Condition="$(_PackageIdentityWanted.Length) &gt; $(_MostCharactersInAPackageName)"
           Text="PackageIdentitySuffix '$(PackageIdentitySuffix)' would make the package identity $(_PackageIdentityWanted), which is $(_PackageIdentityWanted.Length) characters. Windows caps a package name at $(_MostCharactersInAPackageName) and Add-AppxPackage refuses a longer one without saying why. $(_PackageIdentityInTheSource) leaves $([MSBuild]::Subtract($(_MostCharactersInAPackageName), $(_PackageIdentityInTheSource.Length))) characters for the suffix - see docs/ui-probe.md." />

    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($(_PackageIdentityWanted), '\A[-.A-Za-z0-9]+\z'))"
           Text="PackageIdentitySuffix '$(PackageIdentitySuffix)' would make the package identity '$(_PackageIdentityWanted)', which a package name may not be. Windows allows letters, digits, a dash and a dot, and nothing else - no underscore, no space, no accent, no line break - and Add-AppxPackage refuses one without saying why. Keep the suffix to those characters and on one line - see docs/ui-probe.md." />

    <!-- Only when there is a suffix: with none this is the value the SDK picks anyway, and setting
         it would make the ordinary build differ from the build everybody already has. -->
    <PropertyGroup Condition="'$(PackageIdentitySuffix)' != ''">
      <ProjectPriIndexName>$(_PackageIdentityWanted)</ProjectPriIndexName>
    </PropertyGroup>

    <!-- Said out loud, because the alternative to saying it is a silent wrong answer. The suffix
         arrives through a hand-written file with a hand-typed element name, and the build's reply
         to `<PackageIdentitySuffx>` would otherwise be to succeed, write the shared identity, and
         let whoever is reading register over another agent's package. -->
    <Message Importance="high" Condition="'$(PackageIdentitySuffix)' != ''"
             Text="Package identity for this checkout: $(_PackageIdentityWanted). Register this build output before driving it - see docs/ui-probe.md." />

    <Warning Condition="'$(Configuration)' == 'Debug' And '$(PackageIdentitySuffix)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\PackageIdentity.props')"
             Text="PackageIdentity.props is there and sets no PackageIdentitySuffix, so this build carries the identity every other checkout carries. Check the element name - see docs/ui-probe.md." />
  </Target>

  <!--
    makepri does not re-run when the only thing that changed is the name it indexes under: nothing
    it takes as an input is newer than what it wrote. Adding or editing PackageIdentity.props gets
    away with that, because the file is itself a project input and the whole build re-evaluates —
    and deleting it does not, because deleting a file makes nothing newer. Measured: after removing
    the file, the manifest went back to the plain identity and resources.pri stayed on the suffixed
    one. So the name the PRI was last built under is kept beside it, and a disagreement takes the
    PRI out of the way for the SDK to write again. That is what makes deleting the file put the
    checkout back exactly where writing it found it, rather than most of the way back.
  -->
  <Target Name="ReindexThePriWhenTheIdentityChanged"
          AfterTargets="CalculateAppxGenerateProjectPriEnabled"
          Condition="'$(AppxGeneratePriEnabled)' == 'true'">
    <PropertyGroup>
      <_PriIndexNameStamp>$(IntermediateOutputPath)PriIndexName.stamp</_PriIndexNameStamp>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_PriIndexNameStamp)" Condition="Exists('$(_PriIndexNameStamp)')">
      <Output TaskParameter="Lines" ItemName="_PriIndexNameLastBuilt" />
    </ReadLinesFromFile>

    <Delete Files="$(ProjectPriFullPath)"
            Condition="'@(_PriIndexNameLastBuilt)' != '$(ProjectPriIndexName)' And Exists('$(ProjectPriFullPath)')" />

    <WriteLinesToFile File="$(_PriIndexNameStamp)"
                      Lines="$(ProjectPriIndexName)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_PriIndexNameStamp)" />
    </ItemGroup>
  </Target>

  <!--
    `AfterGenerateAppxManifest` is the Windows App SDK's own hook, and the manifest cannot be
    written any earlier than the moment it exists. The name is the one settled above rather than
    read a second time here, so the manifest and the PRI cannot come out under different names. It
    writes only when the file disagrees with the answer: deleting PackageIdentity.props puts the
    identity back where writing it found it, and a build with no file writes nothing at all.
  -->
  <Target Name="SuffixThePackageIdentity" AfterTargets="AfterGenerateAppxManifest">
    <Error Condition="'$(_PackageIdentityWanted)' == ''"
           Text="DecideThePackageIdentity did not run, so there is no settled identity to write into $(FinalAppxManifestName). It hangs off _ValidatePresenceOfAppxManifestItems, which is the Windows App SDK's - a version that no longer runs it needs this pair of targets re-hung." />

    <XmlPeek XmlInputPath="$(FinalAppxManifestName)"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)">
      <Output TaskParameter="Result" PropertyName="_PackageIdentityAsGenerated" />
    </XmlPeek>

    <XmlPoke Condition="'$(_PackageIdentityAsGenerated)' != '$(_PackageIdentityWanted)'"
             XmlInputPath="$(FinalAppxManifestName)"
             Namespaces="$(_PackageManifestNamespace)"
             Query="$(_PackageIdentityQuery)"
             Value="$(_PackageIdentityWanted)" />
  </Target>
  <!--
    The two faces this package puts on the PATH, put inside the package.

    `Package.appxmanifest` declares an app execution alias for `meeting-transcriber.exe` and one for
    `meeting-transcriber-mcp.exe`. An alias over an executable the package does not carry installs
    and then answers the prompt with *the term is not recognized*, so the two declarations have to
    agree - and the first thing this target does is refuse a build where they do not. The names are
    an item group rather than prose twice over, for the reason `DecideThePackageIdentity` gives
    about batching over an empty item list.

    **It runs on an ordinary build and not only on a publish**, because the MSIX layout is computed
    from the publish list every time: `GetPackagingOutputs` reaches `ComputeFilesToPublish` whether
    or not a package is being made. That is not incidental, it is required - the loose layout under
    `$(OutDir)` is what `docs/ui-probe.md` registers, and its generated manifest carries the same
    three `<Application>` elements, so a layout without the two executables in it is one
    `Add-AppxPackage -Register` refuses with `0x80080204`. Measured 2026-09-16. So the faces are
    copied into `$(OutDir)` as well as added to the payload, and the cost - two nested publishes -
    falls on every build of this project and not on the packaging command alone.

    **Every file of a face's publish the application's own publish does not already carry, by name,
    and not a fixed list.** Measured 2026-09-16: `MeetingTranscriber.Cli` contributes its own four
    files to the application's 270, and `MeetingTranscriber.Mcp` contributes its own four plus
    `ModelContextProtocol.Core.dll` and `Microsoft.Extensions.AI.Abstractions.dll`, which are
    assemblies this application has never referenced. A list written from the first face would have
    shipped a package that starts the server and throws on its first tool call.

    A name the application already publishes is taken from the application's copy. Two faces
    contributing one name the application does not have is left to fail loudly as NETSDK1152, which
    names the file and both sources: choosing a winner there is a decision nothing here can make.

    `.pdb` files are skipped because nobody debugs from an installed MSIX.
  -->
  <ItemGroup>
    <Face Include="..\MeetingTranscriber.Cli\MeetingTranscriber.Cli.csproj">
      <Name>meeting-transcriber</Name>
    </Face>
    <Face Include="..\MeetingTranscriber.Mcp\MeetingTranscriber.Mcp.csproj">
      <Name>meeting-transcriber-mcp</Name>
    </Face>
  </ItemGroup>

  <PropertyGroup>
    <_AliasNamespaces>$(_PackageManifestNamespace)&lt;Namespace Prefix="u5" Uri="http://schemas.microsoft.com/appx/manifest/uap/windows10/5" /&gt;</_AliasNamespaces>
    <_AliasedExecutableQuery>//u5:Extension[@Category='windows.appExecutionAlias']/@Executable</_AliasedExecutableQuery>

    <!--
      **The two global properties of docs/packaging.md §3's command that reach a face.** Every
      switch on that command is a global property, and the `MSBuild` task hands global properties to
      the child unless they are named here.

      - `Platform=x64` is the one this is really defending against. It would reach both faces and,
        through their `ProjectReference` closures, `Audio`, `Domain`, `Infrastructure`, `Processing`
        and `Recording` - this application's own dependencies - which is the double-build the
        paragraph in `Directory.Build.props` was written to end. `EnableDynamicPlatformResolution`
        does not cover it: it fixes `ProjectReference` negotiation, and a project invoked by path is
        not a `ProjectReference` and gets no negotiation.
      - `PublishProfile=win-x64` would reach two projects that have no such profile, and the SDK
        does not ignore a publish profile it cannot find.

      The rest of that command - the two `Appx` switches and the two certificate properties - are
      MSIX properties, and a face is a plain SDK project importing no MSIX targets, so they are
      inert there. Naming them would be defending against nothing.
    -->
    <_FacePropertiesToDrop>Platform;PublishProfile</_FacePropertiesToDrop>
    <_FacePublishProperties>Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true</_FacePublishProperties>
  </PropertyGroup>

  <Target Name="PublishTheCommandLineFacesIntoThePackage"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <!--
      **The manifest and the item group above are two halves of one declaration, and this is what
      holds them together.** Either half alone is a silent wrong: an alias with no face is a name
      that installs and resolves to nothing, and a face with no alias is an executable in the package
      nobody outside the window can start. Read off the manifest rather than written down a third
      time, so a new face is one row here and one `<Application>` block there and neither can be
      forgotten.
    -->
    <XmlPeek XmlInputPath="@(AppxManifest->'%(FullPath)')"
             Namespaces="$(_AliasNamespaces)"
             Query="$(_AliasedExecutableQuery)">
      <Output TaskParameter="Result" ItemName="_AliasedExecutable" />
    </XmlPeek>

    <ItemGroup>
      <_FaceExecutable Include="@(Face->'%(Name).exe')" />
      <_AliasWithNoFace Include="@(_AliasedExecutable)" Exclude="@(_FaceExecutable)" />
      <_FaceWithNoAlias Include="@(_FaceExecutable)" Exclude="@(_AliasedExecutable)" />
    </ItemGroup>

    <Error Condition="'@(_AliasWithNoFace)' != ''"
           Text="@(AppxManifest) declares an app execution alias for @(_AliasWithNoFace->'%(Identity)', ', '), and no &lt;Face&gt; in MeetingTranscriber.App.csproj publishes it. That package installs and puts a name on the PATH resolving to nothing - see docs/packaging.md §3.1." />

    <Error Condition="'@(_FaceWithNoAlias)' != ''"
           Text="MeetingTranscriber.App.csproj publishes @(_FaceWithNoAlias->'%(Identity)', ', ') into the package and @(AppxManifest) declares no app execution alias for it. Inside an MSIX the install directory is read-only and its path carries the version, so an executable with no alias is one nothing outside the window can start - see docs/packaging.md §3.1." />

    <!--
      The publish directory has to be absolute: MSBuild resolves a relative `PublishDir` against the
      project being built, so a relative path handed to a face names a folder under *its* directory
      while this project reads one under its own. `NormalizeDirectory` rather than concatenation, so
      an `IntermediateOutputPath` that is already rooted stays where it is.

      Emptied first, because nothing else ever empties it. A publish does not prune its destination,
      so a dependency dropped from a face - or a face that was renamed - would otherwise keep being
      swept up and shipped for as long as the folder survived, and `Clean` would not reach it.
    -->
    <PropertyGroup>
      <_FacesRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'faces'))</_FacesRoot>
      <_FacesRestoreSessionId>$([System.Guid]::NewGuid())</_FacesRestoreSessionId>
    </PropertyGroup>

    <RemoveDir Directories="$(_FacesRoot)" />

    <!--
      **A RID-specific publish needs a `project.assets.json` carrying a target for that RID, and the
      solution's restore writes none** for a project declaring no `RuntimeIdentifiers`: without this
      the publish stops on NETSDK1047. The two extra properties are the ones `/restore` itself
      passes and both are load-bearing - a restore inside a running build otherwise leaves the
      publish underneath reading the evaluation from before it, which is green on a machine that has
      built once and red on a clean checkout.

      `<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>` on the two faces deletes all of this, and it
      is the better shape: `win-x64` is a fact about two projects that ship only inside an x64
      package, and declaring it there would also stop this build and the solution's restore writing
      each other's answer into five shared projects' assets files turn about. It is not done here
      because those two csproj files belong to another share this batch; the PR says so.
    -->
    <MSBuild Projects="@(Face)"
             Targets="Restore"
             RemoveProperties="$(_FacePropertiesToDrop)"
             Properties="$(_FacePublishProperties);ExcludeRestorePackageImports=true;MSBuildRestoreSessionId=$(_FacesRestoreSessionId)" />

    <MSBuild Projects="@(Face)"
             Targets="Publish"
             RemoveProperties="$(_FacePropertiesToDrop)"
             Properties="$(_FacePublishProperties);PublishDir=$(_FacesRoot)%(Face.Name)\" />

    <!-- What a face is made of. The state this catches is `%(Face.Name)` drifting from the face's
         own `<AssemblyName>`, which is the one coupling the item group above introduces: a publish
         that failed has already failed the build, and one that succeeded always writes these four. -->
    <ItemGroup>
      <_FaceMustCarry Include="$(_FacesRoot)%(Face.Name)\%(Face.Name).exe" />
      <_FaceMustCarry Include="$(_FacesRoot)%(Face.Name)\%(Face.Name).dll" />
      <_FaceMustCarry Include="$(_FacesRoot)%(Face.Name)\%(Face.Name).deps.json" />
      <_FaceMustCarry Include="$(_FacesRoot)%(Face.Name)\%(Face.Name).runtimeconfig.json" />
      <_FaceIsMissing Include="@(_FaceMustCarry)" Condition="!Exists('%(_FaceMustCarry.Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_FaceIsMissing)' != ''"
           Text="The publish under $(_FacesRoot) did not produce @(_FaceIsMissing->'%(Filename)%(Extension)', ', '). A Face's Name has to be the AssemblyName that face publishes under, because Package.appxmanifest names that executable and an alias over an executable the package does not carry fails at the prompt with 'the term is not recognized' - see docs/packaging.md §3.1." />

    <!-- Named by where each file sits under its own face's publish root and not by its file name
         alone: a publish is not always flat - a satellite assembly sits under its culture - and
         flattening one onto the package root puts it where nothing loads it. It is also what makes
         the subtraction below a comparison of like with like, `RelativePath` being that same
         path. -->
    <ItemGroup>
      <_FaceFile Include="$(_FacesRoot)%(Face.Name)\**\*" Exclude="$(_FacesRoot)%(Face.Name)\**\*.pdb" />

      <_FaceFileInThePackage Include="@(_FaceFile->'%(RecursiveDir)%(Filename)%(Extension)')">
        <Source>%(_FaceFile.FullPath)</Source>
      </_FaceFileInThePackage>

      <_FaceFileInThePackage Remove="@(ResolvedFileToPublish->'%(RelativePath)')" />

      <ResolvedFileToPublish Include="@(_FaceFileInThePackage->'%(Source)')">
        <RelativePath>%(_FaceFileInThePackage.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!-- And into the build output, which is the other layout carrying a generated manifest - the
         one `docs/ui-probe.md` registers. `ResolvedFileToPublish` does not reach it, and a layout
         whose manifest names an executable the folder does not hold is refused outright. -->
    <Copy SourceFiles="@(_FaceFileInThePackage->'%(Source)')"
          DestinationFiles="@(_FaceFileInThePackage->'$(OutDir)%(Identity)')"
          SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
</Project>
