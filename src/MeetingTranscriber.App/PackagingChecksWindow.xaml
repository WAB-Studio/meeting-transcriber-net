<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingTranscriber.App.PackagingChecksWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in. -->

    <!-- Papel and opaque, like every other window: never mica or acrylic. This screen is
         scaffolding rather than one of the eighteen, and it is drawn from Olivo anyway — a screen
         held to a different vocabulary because it is temporary is a screen that teaches the
         vocabulary is optional. -->

    <Grid
        Background="{StaticResource PaperBrush}"
        Padding="{StaticResource ScreenPadding}"
        RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{x:Bind In(loc:UiTexts.PackagingChecks)}" Style="{StaticResource ScreenTitleText}" />
            <TextBlock
                Text="{x:Bind In(loc:UiTexts.PackagingChecksAreScaffolding)}"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button x:Name="EnvironmentButton" Style="{StaticResource NormalButtonOnPaper}" Click="OnRunEnvironmentProbe" Content="{x:Bind In(loc:UiTexts.ChildEnvironmentCheck)}" />
            <Button x:Name="FileSystemButton" Style="{StaticResource NormalButtonOnPaper}" Click="OnRunFileSystemProbe" Content="{x:Bind In(loc:UiTexts.WritePathCheck)}" />
            <Button x:Name="SaveButton" Style="{StaticResource NormalButtonOnPaper}" Click="OnSaveReport" Content="{x:Bind In(loc:UiTexts.SaveReport)}" />
            <!-- Its label beside it and not over it. A picker is a pill now — 34 high, the value
                 and a chevron — and a pill has no header. This one had one, and the day the pill
                 arrived the word *Idioma* stopped being drawn here with nothing red anywhere,
                 because `Header` is still a real property that the picker simply no longer
                 presents. What stops the next screen learning that the same way is the check in
                 PickerPanelTests that no picker names a header at all. -->
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind In(loc:UiTexts.Language)}"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}" />
            <ComboBox
                x:Name="LanguagePicker"
                Style="{StaticResource DropDown}"
                AutomationProperties.Name="{x:Bind In(loc:UiTexts.Language)}"
                SelectionChanged="OnLanguageChosen" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="OutputText"
                Style="{StaticResource DataText}"
                Foreground="{StaticResource InkBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="NoWrap" />
        </ScrollViewer>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusText"
            Style="{StaticResource BodyText}"
            Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
