<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeetingTranscriber.App.ReadingAMeeting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         One screen for all three stages, and it is the same screen each time. A meeting gains a
         transcription and then a summary, and each of those fills in more of what is already here
         rather than replacing it — so what the reader sees change between the stages is how much
         is on the screen, never which screen they are on. What decides that is MeetingScreen, in a
         project a build agent can run; this file turns the answer into controls.

         What the AI left is built in the code-behind rather than templated here, for the reason
         the meeting cards are: which sections exist and how many things are in each is an answer,
         not a layout. The look stays here, as the styles below, so the code-behind chooses a style
         and never a colour.

         The player is along the bottom and is on screen at every stage above the first. Hearing
         what a meeting recorded is never something anybody is charged for, so nothing here waits
         on a transcription and nothing here mentions one. -->

    <Grid x:Name="Root" RowSpacing="12">
        <Grid.Resources>
            <Style x:Key="ReadingCard" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- What the meeting was about, in the summary's own words. It is the one block on this
                 screen that is not a list, and it sits on the tint the rest of the application uses
                 for something addressed to the reader rather than to the machine. Windows' own
                 brush and not Olivo's `#EEF2EF`, for the reason MeetingsDrawer.xaml gives about
                 the two tints: this application is not drawn from that palette yet, and a literal
                 here would be one more thing for ISC-173 to find. -->
            <Style x:Key="TheAbstract" TargetType="Border" BasedOn="{StaticResource ReadingCard}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />

            <Style x:Key="SectionCount" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <Style x:Key="Said" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The transcript, unfolded under the thing that cited it. Quieter than the sentence
                 above it on purpose: what is being read is the claim, and this is what it rests
                 on. -->
            <Style x:Key="Quoted" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <Style x:Key="Data" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <!-- The press on every thing the AI left. It carries the minute it was said at, and
                 that minute is the whole of its words: a play glyph beside a number, repeated
                 twelve times down a column, is twelve controls saying the same thing. -->
            <Style x:Key="WhenItWasSaid" TargetType="Button">
                <Setter Property="Padding" Value="10,2,10,2" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="TakeTheStage" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />

            <!-- One mark along the track for each thing the AI left, so where each of them falls
                 across the hour is visible without reading a list. -->
            <Style x:Key="ACitationOnTheTrack" TargetType="Rectangle">
                <Setter Property="Height" Value="8" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header. A sub-screen: it is reached from one place and returns to it, and the way
             back says where back is rather than saying "back". -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Click="OnBack"
                Content="{x:Bind In(loc:UiTexts.BackToTheMeetings)}" />

            <StackPanel Grid.Column="1" Spacing="2">
                <!-- The name, and it is a field rather than a line of text because a meeting's
                     name is the person's to set at any time after it was recorded. It commits
                     when the field is left and when Enter is pressed, and never on each key: a
                     write per keystroke is a row touched and a recovery card rewritten thirty
                     times for one title.

                     Nothing fills it in. A meeting nobody has named has an empty field with its
                     header above it, which reads as one nobody has named — where a placeholder
                     worked out from the date would read as a name the application chose. -->
                <TextBox
                    x:Name="NameBox"
                    HorizontalAlignment="Left"
                    MinWidth="360"
                    MaxWidth="560"
                    LostFocus="OnNameLeft"
                    KeyDown="OnNameKey"
                    Header="{x:Bind In(loc:UiTexts.TheMeetingsName)}" />

                <!-- When it was and how long it ran: the machine's own numbers, so the same in
                     either language. -->
                <TextBlock x:Name="WhenText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />

                <TextBlock
                    x:Name="StageText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Opacity="0.75" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- What the AI left. Empty at the stages where it has left nothing, and empty rather
                 than carrying a sentence about what is missing: the right column already offers
                 the act that would fill it, and a screen saying "there is no summary yet" beside
                 a button reading *Summarise* is the same fact twice. -->
            <ScrollViewer Grid.Column="0">
                <StackPanel x:Name="TheSections" Spacing="12" />
            </ScrollViewer>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource ReadingCard}">
                    <StackPanel Spacing="8">
                        <!-- Who wrote this. A summary is a machine's words under a meeting's own
                             name, so whose words they are is said here rather than left to be
                             worked out from which buttons are on screen. -->
                        <TextBlock x:Name="TranscribedText" TextWrapping="Wrap" />
                        <TextBlock x:Name="SummarisedText" TextWrapping="Wrap" />

                        <!-- The stage's two answers, in the two places docs/design.md fixes: the
                             neutral one on the left and the act on the right, exactly as they sit
                             on the list. Built in the code-behind because which of them exist is
                             an answer and not a layout. -->
                        <StackPanel x:Name="Presses" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- The player. On screen at every stage that has audio under it, which is every stage but
             the first, and never conditioned on a transcription having been paid for. -->
        <Grid x:Name="Player" Grid.Row="2" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayButton" Grid.Column="0" Click="OnPlayOrPause" />

            <TextBlock x:Name="AtText" Grid.Column="1" VerticalAlignment="Center" MinWidth="64" />

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Where each thing the AI left falls across the meeting. A canvas because the
                     marks are placed at a fraction of the track's width, which is a number nothing
                     but the laid-out control knows — so they are drawn again whenever it
                     changes. -->
                <Canvas x:Name="Marks" Grid.Row="0" Height="8" SizeChanged="OnTrackResized" />

                <!-- A second a step, and the maximum is the meeting's length in milliseconds. It
                     is the keyboard that decides this: a step of one would move an arrow press a
                     millisecond, which is the whole track unreachable from a keyboard, and this
                     slider carries the player's only name in the automation tree. -->
                <Slider
                    x:Name="Track"
                    Grid.Row="1"
                    Minimum="0"
                    StepFrequency="1000"
                    ValueChanged="OnTrackMoved"
                    AutomationProperties.Name="{x:Bind In(loc:UiTexts.HowFarIntoTheMeeting)}" />
            </Grid>

            <TextBlock x:Name="LengthText" Grid.Column="3" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>

        <!-- Where the player would be, when it will not play. A machine with nothing to play
             through, or a recording whose file has gone, is not something this screen can do
             anything about — so it says what happened and leaves the rest of the meeting
             readable. -->
        <TextBlock
            x:Name="PlayerStatusText"
            Grid.Row="2"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Opacity="0.7" />
    </Grid>
</UserControl>
