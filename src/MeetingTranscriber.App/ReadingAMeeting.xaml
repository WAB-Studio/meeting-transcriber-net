<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeetingTranscriber.App.ReadingAMeeting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         One screen for all three stages, and it is the same screen each time. A meeting gains a
         transcription and then a summary, and each of those fills in more of what is already here
         rather than replacing it — so what the reader sees change between the stages is how much
         is on the screen, never which screen they are on. What decides that is MeetingScreen, in a
         project a build agent can run; this file turns the answer into controls.

         What the AI left is built in the code-behind rather than templated here, for the reason
         the meeting cards are: which sections exist and how many things are in each is an answer,
         not a layout. The look stays here, as the styles below, so the code-behind chooses a style
         and never a colour.

         The player is along the bottom and is on screen at every stage above the first. Hearing
         what a meeting recorded is never something anybody is charged for, so nothing here waits
         on a transcription and nothing here mentions one. -->

    <Grid x:Name="Root" RowSpacing="12">
        <Grid.Resources>
            <Style x:Key="ReadingCard" TargetType="Border" BasedOn="{StaticResource Card}" />

            <!-- What the meeting was about, in the summary's own words. It is the one block on this
                 screen that is not a list, and it sits on the tint the rest of the application uses
                 for something addressed to the reader rather than to the machine, which
                 `docs/design.md` §Reunion names outright: the abstract sits on the decision tint.
                 It was Windows' own brush standing in for that until ISC-173 put every screen on
                 one visual system, which is this change. -->
            <Style x:Key="TheAbstract" TargetType="Border" BasedOn="{StaticResource WaitingOnADecisionCard}">
                <Setter Property="Padding" Value="{StaticResource LargeCardPadding}" />
            </Style>

            <!-- A section of the meeting, at the rank `docs/design.md` §Type gives one. This
                 screen's own title is the sub-screen rank above it, because a meeting is reached
                 from the list and returns to it. -->
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionText}" />

            <Style x:Key="SectionCount" TargetType="TextBlock" BasedOn="{StaticResource DataText}" />

            <!-- What the AI left, in its own words: a sentence somebody reads, so the body rank. -->
            <Style x:Key="Said" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The transcript, unfolded under the thing that cited it. Quieter than the sentence
                 above it on purpose: what is being read is the claim, and this is what it rests
                 on. It is the transcript rank, which is the one rank on the ramp set at 15/26 and
                 exists for exactly this: a stretch of what was actually said, read at length. -->
            <Style x:Key="Quoted" TargetType="TextBlock" BasedOn="{StaticResource TranscriptText}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            </Style>

            <!-- One turn of the transcript, at the transcript rank in full ink: it is what was said
                 and the thing being read, where `Quoted` is what a claim rests on and is quieter
                 than the claim. It is selectable, and the selection is what *Corregir* takes. -->
            <Style x:Key="Spoken" TargetType="TextBlock" BasedOn="{StaticResource TranscriptText}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="Data" TargetType="TextBlock" BasedOn="{StaticResource DataText}" />

            <!-- One thing this meeting was filed under: the whole path down the tree, as one chip.
                 The path and not its deepest node alone, because *ticket #4312* on its own says
                 nothing and the company above it is what makes it a subject. It is the press that
                 opens that node's own history — the whole path down the tree, and not only its
                 deepest node, because what it opens is one node's story and the path is how
                 somebody reads up from there. -->
            <Style x:Key="FiledUnder" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Padding" Value="11,0,11,0" />
            </Style>

            <Style x:Key="FiledUnderSays" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />

            <!-- A meeting nobody filed. It is a real answer and not a gap: §5.3 says a casual chat
                 is stored with no links at all and found by text. -->
            <Style x:Key="FiledUnderNothing" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
            </Style>

            <!-- The press on every thing the AI left. It carries the minute it was said at, and
                 that minute is the whole of its words: a play glyph beside a number, repeated
                 twelve times down a column, is twelve controls saying the same thing. -->
            <Style x:Key="WhenItWasSaid" TargetType="Button" BasedOn="{StaticResource RowButtonOnCard}">
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource NumberFace}" />
                <Setter Property="FontSize" Value="{StaticResource DataSize}" />
            </Style>

            <!-- The act on the right, and the normal rank rather than pico or the platform's
                 accent. *Transcribir* spends at once now, on this machine's own key, with no price
                 shown — `docs/design.md` puts a dialogue in front of that charge and it is not
                 built yet (ISC-85). `docs/design.md` §Controls keeps the rank normal anyway: pico
                 belongs to what costs money and the normal rank to a press that opens the
                 question, which is where this one goes back to the day the dialogue lands. The
                 accent brush this replaced was the system's own, which §And five things this
                 application is not rules out on its own: this application has two colours and
                 they are on that page. -->
            <Style x:Key="TakeTheStage" TargetType="Button" BasedOn="{StaticResource RowButtonOnCard}" />

            <!-- One summary the meeting was given, as a radio row of Olivo's `Option`. Declared here
                 because `Chrome()` reads this screen's resources and not the application's. -->
            <Style x:Key="ASummaryOfThisMeeting" TargetType="RadioButton" BasedOn="{StaticResource Option}" />

            <!-- One mark along the track for each thing the AI left, so where each of them falls
                 across the hour is visible without reading a list. -->
            <Style x:Key="ACitationOnTheTrack" TargetType="Rectangle">
                <Setter Property="Height" Value="8" />
                <Setter Property="Fill" Value="{ThemeResource OliveBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header. A sub-screen: it is reached from one place and returns to it, through
             `GoBack`, which the window's app bar calls. -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="2">
                <!-- The name, and it is a field rather than a line of text because a meeting's
                     name is the person's to set at any time after it was recorded. It commits
                     when the field is left and when Enter is pressed, and never on each key: a
                     write per keystroke is a row touched and a recovery card rewritten thirty
                     times for one title.

                     Nothing fills it in. A meeting nobody has named has an empty field with its
                     header above it, which reads as one nobody has named — where a placeholder
                     worked out from the date would read as a name the application chose. -->
                <TextBox
                    x:Name="NameBox"
                    Style="{StaticResource TypedField}"
                    HorizontalAlignment="Left"
                    MinWidth="360"
                    MaxWidth="560"
                    LostFocus="OnNameLeft"
                    KeyDown="OnNameKey"
                    Header="{x:Bind In(loc:UiTexts.TheMeetingsName)}" />

                <!-- When it was and how long it ran: the machine's own numbers, so the same in
                     either language. -->
                <TextBlock x:Name="WhenText" Style="{StaticResource DataText}" />

                <TextBlock
                    x:Name="StageText"
                    Style="{StaticResource BodyText}"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- What the AI left. Empty at the stages where it has left nothing, and empty rather
                 than carrying a sentence about what is missing: the right column already offers
                 the act that would fill it, and a screen saying "there is no summary yet" beside
                 a button reading *Summarise* is the same fact twice. -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="12">
                    <StackPanel x:Name="TheSections" Spacing="12" />

                    <!-- The whole transcript, under what the AI left or alone when it left nothing.
                         Collapsed until the meeting is transcribed. One line per turn, built by the
                         code-behind as a line comes into view: a repeater and never a panel holding
                         an element per turn, so an hour of talk costs no more than five minutes of
                         it. Its scroller is the one around this column. -->
                    <Border x:Name="TheTranscriptCard" Style="{StaticResource ReadingCard}" Visibility="Collapsed">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{x:Bind In(loc:UiTexts.TheTranscript)}" />

                                <!-- Only while words are selected on a line, and carrying them: the
                                     same act the line's right-click offers, for a pointer that has
                                     nothing to right-click with. -->
                                <Button
                                    x:Name="CorrectAWordButton"
                                    AllowFocusOnInteraction="False"
                                    Grid.Column="1"
                                    Style="{StaticResource TakeTheStage}"
                                    Click="OnCorrectTheSelection"
                                    Content="{x:Bind In(loc:UiTexts.CorrectThisWord)}"
                                    Visibility="Collapsed" />
                            </Grid>

                            <ItemsRepeater x:Name="TheTranscriptLines" Grid.Row="1">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Scrolls apart from the left, so a short window cuts nothing off: with the card of
                 words below the others it was the press that fell out of reach. -->
            <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource ReadingCard}">
                    <StackPanel Spacing="8">
                        <!-- Who made what, and when: a compact table, a row per stage that has
                             happened. Whose words a summary is stays said, because a summary is a
                             machine's words under a meeting's own name; it is said in the fewest
                             words that carry it. Collapsed whole when nothing has happened yet, and
                             the list's own word above says that. -->
                        <Grid x:Name="WhoMadeWhat" ColumnSpacing="12" RowSpacing="4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="TranscribedLabel"
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource DataText}"
                                Text="{x:Bind In(loc:UiTexts.Transcribed)}" />
                            <TextBlock
                                x:Name="TranscribedText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource DataText}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="SummarisedLabel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource DataText}"
                                Text="{x:Bind In(loc:UiTexts.Summarised)}" />
                            <TextBlock
                                x:Name="SummarisedText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource DataText}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- What a summary came to when it was refused or failed: the one place on
                             this card that carries a sentence, because it is the one place
                             something failed. -->
                        <TextBlock
                            x:Name="SummaryFailedText"
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <!-- Every summary the meeting was given, one radio row each, newest accepted
                             first, the checked one being the summary on screen. Drawn only when
                             there are two or more: one summary has nothing to choose. A radio at
                             two as at ten, because the set only grows and a control that changes
                             shape at the third is two controls for one choice. The label is mono
                             at the data rank, like the cards below. -->
                        <StackPanel x:Name="TheSummariesCard" Spacing="6" Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource DataText}"
                                Text="{x:Bind In(loc:UiTexts.ThisMeetingsSummaries)}" />

                            <StackPanel
                                x:Name="TheSummaries"
                                Spacing="2"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.ThisMeetingsSummaries)}" />
                        </StackPanel>

                        <!-- The stage's two answers, in the two places docs/design.md fixes: the
                             neutral one on the left and the act on the right, exactly as they sit
                             on the list. Built in the code-behind because which of them exist is
                             an answer and not a layout. -->
                        <StackPanel x:Name="Presses" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- What this meeting was filed under, and the way to set it. `Reunion.dc.html`
                     draws it as a card of its own in this column and nothing built it until now.
                     The label is mono at the data rank, like *esto lo escribió* above it: it names
                     the block rather than being a heading over a part of the screen.

                     The artboard draws no press here and there is one, at the same normal rank the
                     act on the card above takes. A block showing a filing with no way to set it is
                     worse than no block, and *Clasificar* is already the verb `docs/design.md`
                     §One verb per act gives for this. -->
                <Border Style="{StaticResource ReadingCard}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource DataText}"
                            Text="{x:Bind In(loc:UiTexts.WhatItWasFiledUnder)}" />

                        <local:WrappingRow x:Name="TheFiling" HorizontalGap="6" VerticalGap="6" />

                        <Button
                            x:Name="ClassifyButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TakeTheStage}"
                            Click="OnClassify"
                            Content="{x:Bind In(loc:UiTexts.Classify)}" />
                    </StackPanel>
                </Border>

                <!-- Who spoke, and the way to say who is who. Collapsed rather than drawn empty:
                     a meeting nothing has transcribed yet has no voices to offer. The label is
                     mono at the data rank, like *sobre qué fue* and *esto lo escribió* above it. -->
                <Border x:Name="WhoSpokeCard" Style="{StaticResource ReadingCard}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource DataText}"
                            Text="{x:Bind In(loc:UiTexts.WhoSpoke)}" />

                        <StackPanel x:Name="TheVoices" Spacing="4" />

                        <Button
                            x:Name="NameTheVoicesButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TakeTheStage}"
                            Click="OnNameTheVoices"
                            Content="{x:Bind In(loc:UiTexts.SayWhoIsWho)}" />
                    </StackPanel>
                </Border>

                <!-- The way to correct the words that come out wrong. Collapsed until the meeting has a
                     transcription: before that there are no words to be wrong. The label is mono at
                     the data rank, like the cards above it. -->
                <Border x:Name="WordsCard" Style="{StaticResource ReadingCard}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource DataText}"
                            Text="{x:Bind In(loc:UiTexts.WordsThatComeOutWrongHere)}" />

                        <Button
                            x:Name="CorrectWordsButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TakeTheStage}"
                            Click="OnCorrectWords"
                            Content="{x:Bind In(loc:UiTexts.CorrectWords)}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The player. On screen at every stage that has audio under it, which is every stage but
             the first, and never conditioned on a transcription having been paid for. -->
        <Grid x:Name="Player" Grid.Row="2" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PlayButton"
                Grid.Column="0"
                Style="{StaticResource NormalButtonOnPaper}"
                Click="OnPlayOrPause" />

            <!-- How far into the meeting, against how long it is: two numbers read against each
                 other, so the data rank. -->
            <TextBlock
                x:Name="AtText"
                Grid.Column="1"
                VerticalAlignment="Center"
                MinWidth="64"
                Style="{StaticResource DataText}" />

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Where each thing the AI left falls across the meeting. A canvas because the
                     marks are placed at a fraction of the track's width, which is a number nothing
                     but the laid-out control knows — so they are drawn again whenever it
                     changes. -->
                <Canvas x:Name="Marks" Grid.Row="0" Height="8" SizeChanged="OnTrackResized" />

                <!-- A second a step, and the maximum is the meeting's length in milliseconds. It
                     is the keyboard that decides this: a step of one would move an arrow press a
                     millisecond, which is the whole track unreachable from a keyboard, and this
                     slider carries the player's only name in the automation tree. -->
                <Slider
                    x:Name="Track"
                    Grid.Row="1"
                    Foreground="{ThemeResource OliveBrush}"
                    Minimum="0"
                    StepFrequency="1000"
                    ValueChanged="OnTrackMoved"
                    AutomationProperties.Name="{x:Bind In(loc:UiTexts.HowFarIntoTheMeeting)}" />
            </Grid>

            <TextBlock
                x:Name="LengthText"
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource DataText}" />
        </Grid>

        <!-- Where the player would be, when it will not play. A machine with nothing to play
             through, or a recording whose file has gone, is not something this screen can do
             anything about — so it says what happened and leaves the rest of the meeting
             readable. -->
        <TextBlock
            x:Name="PlayerStatusText"
            Grid.Row="2"
            Style="{StaticResource BodyText}"
            Foreground="{ThemeResource PeakBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- The dialogue that corrects one word where it is read: the third `docs/design.md`
             §Notices allows, shared with the screen that names voices. -->
        <local:CorrectingAWord x:Name="AskingHowAWordGoes" />
    </Grid>
</UserControl>
