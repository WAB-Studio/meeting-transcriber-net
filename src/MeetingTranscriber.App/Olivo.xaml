<?xml version="1.0" encoding="utf-8"?>

<!-- Olivo, as resources. `docs/design.md` is the authority and this file is that page reaching the
     screen: every colour, every type rank, every corner and every height a screen uses is a key
     here, and a screen that reaches for a value of its own is what OlivoTests fails the build
     over.

     The keys are the ones `docs/design.md` §Colour suggests. That table says the resource key is
     its suggestion and the first screen to need one settles it — this is that screen, so these are
     the names, and every screen after this one uses them rather than proposing its own.

     Brushes are the one thing in here that varies by theme. They live in `ThemeDictionaries` under
     two keys, `Default` and `Dark`: `Default` holds the light values and is the key rather than
     `Light` because a theme with no dictionary of its own falls back to `Default`, which covers
     Light and High Contrast alike. `Dark` holds the re-tuned values `docs/design.md` §Colour gives
     in its Dark column. Every brush is reached through `{ThemeResource}`, in this file and in every
     other, and no code resolves one by name — the theme engine is the only thing that decides which
     value a brush key holds. Styles, sizes, fonts, corners and thicknesses do not vary by theme and
     stay `{StaticResource}`. -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App">

    <!-- ── The two colours, the surfaces and the inks ───────────────────────────────────────────

         `docs/design.md` §Two colours and nothing else: olivo is what is alive and well, pico is
         what wants attention, and there is no third accent. Red does not exist in this application
         — recording is olivo, because recording is not an alarm. -->


    <!-- The fifteen brushes, in the order `docs/design.md` §Colour and §Controls give them. Each
         row of those two tables is a key here at both values, and `OlivoTests` holds it to the page.

         `ControlRuleBrush` is the same value as the meter's track and a different role, so a
         different key. A normal button on tarjeta is papel with a 1px rule, and the rule is not the
         dividing line's colour: against tarjeta that one is four per cent of nothing, so the button
         would read as a stray outline. Two roles under one key would mean the day somebody re-tunes
         the meter's track, every button on every card silently moves with it.

         `EmptyControlRingBrush` is the 1px inset ring on an empty or optional control: *Agregar*,
         the `+` at the end of a path, a toggle that is off.

         `UnansweredBrush` is nothing said yet: a voice nobody has named, an unticked box, the ring
         of a radio nobody has chosen. One value, three roles, one key; they get two keys only on the
         day one of them has to diverge. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PaperBrush" Color="#FCFCFB" />
            <SolidColorBrush x:Key="CardBrush" Color="#F4F3EF" />
            <SolidColorBrush x:Key="DecisionTintBrush" Color="#EEF2EF" />
            <SolidColorBrush x:Key="AttentionTintBrush" Color="#F8EDE6" />
            <SolidColorBrush x:Key="InkBrush" Color="#1C1B19" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6C66" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9B9891" />
            <SolidColorBrush x:Key="LineBrush" Color="#E6E4DE" />
            <SolidColorBrush x:Key="MeterTrackBrush" Color="#E1DED7" />
            <SolidColorBrush x:Key="HotZoneBrush" Color="#EDD5C7" />
            <SolidColorBrush x:Key="OliveBrush" Color="#4F7561" />
            <SolidColorBrush x:Key="PeakBrush" Color="#C2683C" />
            <SolidColorBrush x:Key="UnansweredBrush" Color="#C3BFB6" />
            <SolidColorBrush x:Key="ControlRuleBrush" Color="#E1DED7" />
            <SolidColorBrush x:Key="EmptyControlRingBrush" Color="#DEDBD4" />
            <!-- The platform accent family at olivo's value for this theme: the slider's fill
                 and thumb and a text selection draw from it, and `docs/design.md` section "And five
                 things this application is not" says nothing here uses the system accent. -->
            <Color x:Key="SystemAccentColor">#4F7561</Color>
            <Color x:Key="SystemAccentColorLight1">#4F7561</Color>
            <Color x:Key="SystemAccentColorLight2">#4F7561</Color>
            <Color x:Key="SystemAccentColorLight3">#4F7561</Color>
            <Color x:Key="SystemAccentColorDark1">#4F7561</Color>
            <Color x:Key="SystemAccentColorDark2">#4F7561</Color>
            <Color x:Key="SystemAccentColorDark3">#4F7561</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PaperBrush" Color="#1B1A18" />
            <SolidColorBrush x:Key="CardBrush" Color="#22211F" />
            <SolidColorBrush x:Key="DecisionTintBrush" Color="#1E2521" />
            <SolidColorBrush x:Key="AttentionTintBrush" Color="#2A211C" />
            <SolidColorBrush x:Key="InkBrush" Color="#ECEAE5" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8E8B85" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#64615C" />
            <SolidColorBrush x:Key="LineBrush" Color="#2D2C29" />
            <SolidColorBrush x:Key="MeterTrackBrush" Color="#302F2C" />
            <SolidColorBrush x:Key="HotZoneBrush" Color="#402D24" />
            <SolidColorBrush x:Key="OliveBrush" Color="#6A947F" />
            <SolidColorBrush x:Key="PeakBrush" Color="#B86038" />
            <SolidColorBrush x:Key="UnansweredBrush" Color="#45423E" />
            <SolidColorBrush x:Key="ControlRuleBrush" Color="#302F2C" />
            <SolidColorBrush x:Key="EmptyControlRingBrush" Color="#32312E" />
            <!-- The platform accent family at olivo's value for this theme: the slider's fill
                 and thumb and a text selection draw from it, and `docs/design.md` section "And five
                 things this application is not" says nothing here uses the system accent. -->
            <Color x:Key="SystemAccentColor">#6A947F</Color>
            <Color x:Key="SystemAccentColorLight1">#6A947F</Color>
            <Color x:Key="SystemAccentColorLight2">#6A947F</Color>
            <Color x:Key="SystemAccentColorLight3">#6A947F</Color>
            <Color x:Key="SystemAccentColorDark1">#6A947F</Color>
            <Color x:Key="SystemAccentColorDark2">#6A947F</Color>
            <Color x:Key="SystemAccentColorDark3">#6A947F</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ── The two faces ────────────────────────────────────────────────────────────────────────

         Both ship inside the package: `Assets/Fonts/`, listed as Content in the project file, under
         the SIL Open Font License 1.1, which permits bundling with software provided each copy
         carries the notice and the licence — so `SpaceGrotesk-OFL.txt` and `JetBrainsMono-OFL.txt`
         ship beside them. Neither font declares a Reserved Font Name and neither is modified here.

         Variable fonts rather than one file per weight, because Space Grotesk publishes no static
         SemiBold and three of the seven ranks are 600. The `wght` axis covers 300–700 on one and
         100–800 on the other, so every weight the ramp asks for is on the axis.

         **The name after the `#` is the font's own legacy family and not the one on the tin.** A
         variable font carries two: the typographic family, which is `Space Grotesk`, and the
         name-ID-1 family, which names the default instance — and Space Grotesk's default instance
         is Light, so its name-ID-1 family is `Space Grotesk Light`. DirectWrite matches the second.
         Asking for `Space Grotesk` matched nothing, and nothing is what a missing font family is:
         the screen rendered whole in Segoe UI with no warning anywhere, which is why this was found
         by photographing the window and could not have been found by reading the markup. JetBrains
         Mono's default instance is Regular, so its two names agree and it needs no such care.

         No fallback list on the family. `docs/design.md` names `'Segoe UI', system-ui, sans-serif`
         and `'Cascadia Mono', Consolas, monospace` so that a machine without the two fonts still
         reads — a machine that has this application installed has the two fonts, because they are
         inside the package. What that sentence protects is the artboards, which fetch them over
         the network and are opened in a browser; here it would be a fallback for a case nothing
         reaches. DirectWrite still falls back per character for a glyph neither face has. -->

    <FontFamily x:Key="TextFace">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk Light</FontFamily>
    <FontFamily x:Key="NumberFace">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>

    <!-- ── The seven ranks ──────────────────────────────────────────────────────────────────────

         `docs/design.md` §Type. Seven, and a screen uses no size that is not one of them. Mono is
         for every number that gets compared to another one; text never goes in mono, and a number
         that is part of a sentence is text.

         `CharacterSpacing` is thousandths of an em in WinUI, so the page's `-.02em` is -20.
         `LineStackingStrategy` is set with every line height because a TextBlock ignores
         `LineHeight` without it, which would leave six of the seven ranks silently on the font's
         own leading. -->

    <!-- The seven sizes, named, because a rank is a style and not everything that takes one is a
         TextBlock: a button carrying a timestamp is set at the data rank and cannot be `BasedOn` a
         TextBlock's style. The ranks below read these too, so each size is written once. -->

    <x:Double x:Key="StopwatchSize">62</x:Double>
    <x:Double x:Key="ScreenTitleSize">26</x:Double>
    <x:Double x:Key="SubScreenTitleSize">20</x:Double>
    <x:Double x:Key="SectionSize">17</x:Double>
    <x:Double x:Key="TranscriptSize">15</x:Double>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="DataSize">11</x:Double>

    <Style x:Key="StopwatchText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumberFace}" />
        <Setter Property="FontSize" Value="{StaticResource StopwatchSize}" />
        <Setter Property="LineHeight" Value="72" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="ScreenTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource ScreenTitleSize}" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- The rank a sub-screen's own title takes. `docs/design.md` §Type: a sub-screen is one
         reached from another and returning to it, and it carries 20/26 rather than the 26/32 a
         top-level screen does. It was the one rank of the seven with no key, because the only
         sub-screen before this one has no title — the meeting's header is a field with a header of
         its own, so it never needed the rank. -->
    <Style x:Key="SubScreenTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource SubScreenTitleSize}" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionSize}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="TranscriptText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource TranscriptSize}" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="DataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumberFace}" />
        <Setter Property="FontSize" Value="{StaticResource DataSize}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
    </Style>

    <!-- There is no rank-in-another-ink here, and that is deliberate. `docs/design.md` §Type says a
         second line that is quieter is quieter by colour and that there is no rank between Body and
         Data to reach for — so a screen names a rank and a brush, both from the few above, and the
         seven stay seven. A style per rank per ink would be twenty-one styles saying what two names
         side by side already say, and the day a rank changes it would be twenty-one edits.

         Each rank carries the ink that is its own role's: Data is tertiary because that is what
         `docs/design.md` §Colour gives tertiary for — data, counts, units, labels — and everything
         else is tinta. A screen that wants another one says which. -->

    <!-- ── Four radii and no fifth ──────────────────────────────────────────────────────────────

         `docs/design.md` §Radii. Anything pressed is 4, a card or a row is 8, the one thing that
         interrupts the screen is 12, and a circle is a circle where the thing is genuinely round.
         999 does not exist here and neither does a fifth value.

         The circle has no key: a round thing's radius is half its own height, so it is written
         where the height is and a token would be a token per size. -->

    <CornerRadius x:Key="PressedCorner">4</CornerRadius>
    <CornerRadius x:Key="CardCorner">8</CornerRadius>
    <CornerRadius x:Key="InterruptionCorner">12</CornerRadius>

    <!-- ── Heights ──────────────────────────────────────────────────────────────────────────────

         `docs/design.md` §Heights. Height is half of what says a thing is pressable, so each is a
         value and not a range. What tells a control from a container is fill, weight and height —
         never the radius. -->

    <x:Double x:Key="PrincipalActHeight">46</x:Double>
    <x:Double x:Key="NormalButtonHeight">42</x:Double>

    <!-- How strongly a press is veiled under a pointer and while pressed (`docs/design.md` §Colour).
         Named so the two button templates and the drop-down's pill each say one number once. -->
    <x:Double x:Key="PointerVeilOpacity">0.06</x:Double>
    <x:Double x:Key="PressedVeilOpacity">0.12</x:Double>
    <x:Double x:Key="PrincipalPointerVeilOpacity">0.14</x:Double>
    <x:Double x:Key="PrincipalPressedVeilOpacity">0.28</x:Double>

    <!-- A control — a picker, a pill, a two-way. It was missing while the pickers still carried a
         header, because on a `ComboBox` `Height` is the whole control including that header and 34
         left about fourteen pixels for the box: the four pickers on the front door rendered as a
         label over a hairline, so the number was left at the platform's 32 and this key was not
         settled. The picker is a pill now and the header is gone, so 34 is the box and the page's
         own value goes back on. -->
    <x:Double x:Key="ControlHeight">34</x:Double>

    <x:Double x:Key="RowButtonHeight">30</x:Double>

    <!-- ── Spacing ──────────────────────────────────────────────────────────────────────────────

         `docs/design.md` §Spacing, as the values a screen names rather than as a scale to pick
         from. The screen's own margin is the only one that is two numbers, because the page gives
         it as 30 vertical and 40 horizontal. -->

    <!-- Every one of them a Thickness, which is what a padding is. Written as a bare number these
         two set a `Padding` through a `Setter`, which converts, and threw the moment a screen named
         one straight on a control — "the type Double cannot be assigned to the type Thickness", at
         `InitializeComponent`, on a build that compiled green. A key that works in one of the two
         places a screen can name it is a key with a trap in it.

         The values are what they were. The artboards draw the large card at 24 across and 22 down,
         which is inside the page's 20–24 and would be the better number — but this key is also the
         meeting screen's, and re-tuning a shared value on the way past is a change to a screen this
         work did not draw and nobody photographed. -->
    <Thickness x:Key="ScreenPadding">40,30,40,30</Thickness>
    <Thickness x:Key="LargeCardPadding">20</Thickness>
    <Thickness x:Key="SmallCardPadding">16</Thickness>

    <!-- A row of the meetings list, which is one line: the name, when it was, its status and its
         presses. A row that is one line is a card with less in it, and the card's 16 all round
         would make every meeting a block of its own; 13 across and 8 down is what lets a dozen of
         them stand in the room one meeting used to. -->
    <Thickness x:Key="RowPadding">13,8,13,8</Thickness>

    <!-- The one press that loses something sits to the left of the left one, past a gap, so it
         cannot be pressed by reflex. The gap is the whole difference between it and every other
         neutral button. -->
    <Thickness x:Key="PastTheGap">0,0,20,0</Thickness>

    <!-- ── The five control ranks ───────────────────────────────────────────────────────────────

         `docs/design.md` §Controls. A screen has at most one of the first. Every one of them is 4
         at the corner and carries its rank in its fill, and the two places a button can sit — the
         neutral one on the left, the act on the right — are the screen's to lay out rather than
         the style's.

         Each is `BasedOn` the platform's own Button style, so focus, the keyboard and the
         automation peer are the platform's and only what is drawn is Olivo's. -->

    <!-- What every button is drawn with. A press answers a cursor at once, and `docs/design.md`
         §Colour says how: the button is veiled in its own ink — tinta at 6 % under the pointer and
         12 % pressed, the principal act in papel at 14 % and 28 % — under the four keys above.
         Nothing fades in or out. The platform's own template did, over 83 ms, and on a screen where
         nothing else moves that is what read as a flicker; here the state is the state the moment
         the pointer is on it, and there is no `Storyboard` and no `VisualTransition` in either
         template to bring one back.

         The veil is a border laid over the platform's own `ContentPresenter`, which keeps its name:
         the focus rectangle stays the system's and the peer still reads the content off it. It is
         not hit-testable, so a press goes through it to the button.

         Only being dead looks different besides, and it looks different by ink rather than by
         opacity: the words go tertiary and the fill, where the style gives one, stays the style's.
         The principal act is the one button whose fill is ink, and a dead ink block is the loudest
         thing on a screen, so it has the template below and not this one. -->
    <ControlTemplate x:Key="OlivoButtonTemplate" TargetType="Button">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverVeil.Visibility" Value="Visible" />
                            <Setter Target="HoverVeil.Opacity" Value="{StaticResource PointerVeilOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="HoverVeil.Visibility" Value="Visible" />
                            <Setter Target="HoverVeil.Opacity" Value="{StaticResource PressedVeilOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Background="{TemplateBinding Background}"
                Foreground="{TemplateBinding Foreground}"
                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                AutomationProperties.AccessibilityView="Raw" />
            <Border
                x:Name="HoverVeil"
                Background="{ThemeResource InkBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <!-- The same button for the one whose fill is ink: veiled in papel, because ink on ink would
         show nothing; dead, the fill is the rule's colour and the words are tertiary, so it stops
         being the heaviest thing on the screen without turning into a button that looks pressable. -->
    <ControlTemplate x:Key="PrincipalActTemplate" TargetType="Button">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverVeil.Visibility" Value="Visible" />
                            <Setter Target="HoverVeil.Opacity" Value="{StaticResource PrincipalPointerVeilOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="HoverVeil.Visibility" Value="Visible" />
                            <Setter Target="HoverVeil.Opacity" Value="{StaticResource PrincipalPressedVeilOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource LineBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Background="{TemplateBinding Background}"
                Foreground="{TemplateBinding Foreground}"
                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                AutomationProperties.AccessibilityView="Raw" />
            <Border
                x:Name="HoverVeil"
                Background="{ThemeResource PaperBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="OlivoButtonBase" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource NormalButtonHeight}" />
        <Setter Property="Height" Value="{StaticResource NormalButtonHeight}" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="Template" Value="{StaticResource OlivoButtonTemplate}" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
    </Style>

    <!-- The one thing this screen is for: start recording, stop, save. -->
    <Style x:Key="PrincipalActButton" TargetType="Button" BasedOn="{StaticResource OlivoButtonBase}">
        <Setter Property="Background" Value="{ThemeResource InkBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PaperBrush}" />
        <Setter Property="Height" Value="{StaticResource PrincipalActHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource PrincipalActHeight}" />
        <Setter Property="Padding" Value="24,0,24,0" />
        <Setter Property="Template" Value="{StaticResource PrincipalActTemplate}" />
    </Style>

    <!-- Everything else, and it has two fills for the same reason the surfaces alternate: a tarjeta
         button on a tarjeta row is invisible. On papel it is tarjeta with no rule. -->
    <Style x:Key="NormalButtonOnPaper" TargetType="Button" BasedOn="{StaticResource OlivoButtonBase}">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- On tarjeta it is papel with a 1px rule. -->
    <Style x:Key="NormalButtonOnCard" TargetType="Button" BasedOn="{StaticResource OlivoButtonBase}">
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlRuleBrush}" />
    </Style>

    <!-- Dismiss, cancel, leave it as it was. Never filled, always secondary ink. It is the same
         button on every screen and only the word changes. -->
    <Style x:Key="ButtonAtTheMargin" TargetType="Button" BasedOn="{StaticResource OlivoButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,0,12,0" />
    </Style>

    <!-- A small button inside a row: the same ranks at 30. The two places still mean the same thing
         — the neutral one on the left, the act on the right — so these are the two the rows use. -->
    <Style x:Key="RowButtonAtTheMargin" TargetType="Button" BasedOn="{StaticResource ButtonAtTheMargin}">
        <Setter Property="Height" Value="{StaticResource RowButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource RowButtonHeight}" />
    </Style>

    <Style x:Key="RowButtonOnCard" TargetType="Button" BasedOn="{StaticResource NormalButtonOnCard}">
        <Setter Property="Height" Value="{StaticResource RowButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource RowButtonHeight}" />
        <Setter Property="Padding" Value="14,0,14,0" />
    </Style>

    <!-- The one press on this screen that loses something: the row rank at the margin, past the
         gap. Two styles would be two things to keep in step, so the gap is the only difference. -->
    <Style x:Key="RowButtonThatLosesSomething" TargetType="Button" BasedOn="{StaticResource RowButtonAtTheMargin}">
        <Setter Property="Margin" Value="{StaticResource PastTheGap}" />
    </Style>

    <!-- A row that is itself the thing you press. No fill, no rule, no padding and no height of
         its own: what it looks like is whatever is in it, which is how a row can be pressable
         without gaining a control. It is a Button and not a tapped border, because a border that
         answers a press is nothing to a keyboard and nothing to a screen reader.

         Here rather than on the one screen using it today, because "no fill" is a thing the system
         says once. A screen spelling it for itself is a screen choosing a value, which is the whole
         of what ISC-173.1 is against. -->
    <Style x:Key="TheRowItself" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template" Value="{StaticResource OlivoButtonTemplate}" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
    </Style>

    <!-- The way back, which is the app bar's and one for every sub-screen. A circle, because it is
         genuinely round (`docs/design.md` §Radii): 34 high and 34 wide, so its radius is written
         beside its height and is half of it, never a key. The margin rank — it answers nothing and
         asks nothing, it leaves — with a 1px rule so it reads as a thing to press on a bar that
         carries nothing else at its left. The arrow is the button's own content and takes its ink,
         so a dead button dims the arrow with it. -->
    <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonAtTheMargin}">
        <Setter Property="Width" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A press that is a glyph and nothing else: the drawer's caret, the player's play and pause.
         The margin rank at the control height and as wide, with a 1px rule so it reads as a thing
         to press. The glyph is the button's own content, centred, and takes its ink. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonAtTheMargin}">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource EmptyControlRingBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── The two surfaces, and the two tints ──────────────────────────────────────────────────

         Two surfaces and they alternate: the window is papel, a card laid on it is tarjeta, and a
         control sitting on that card is papel again. There is no third — a block nested inside a
         card takes a 1px rule and never a tint of its own. -->

    <!-- What the window is dragged by: an element with a fill nobody sees. A press falls through an
         element that has no fill, so with none the title bar did not move the window (fb-106); the
         screen names this and never writes the fill itself. -->
    <Style x:Key="DragFill" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
        <Setter Property="Padding" Value="{StaticResource SmallCardPadding}" />
    </Style>

    <!-- Something waiting on the person, and the selected option of a set. -->
    <Style x:Key="WaitingOnADecisionCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{ThemeResource DecisionTintBrush}" />
    </Style>

    <!-- Something lost or about to be. Its 18px warning triangle in pico is drawn on the row, not
         here: a Border style cannot add a child, and the triangle is part of what the notice says
         rather than part of what it is laid on. -->
    <Style x:Key="SomethingIsLostCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{ThemeResource AttentionTintBrush}" />
    </Style>

    <!-- ── Controls that are not buttons ────────────────────────────────────────────────────────

         `docs/design.md` §Controls, last paragraph: a drop-down is a 34-high control on papel with
         a 1px `#E6E4DE` rule and an 11px chevron in secondary; a two-way choice is two halves
         inside a `#E6E4DE` trough with 3px of padding. Both are drawn here and both are drawn
         once. -->

    <!-- A pill: 34 high, papel, a 1px rule, radius 4. It is the shape the picker below wears and
         the shape a value that is **shown here and changed elsewhere** wears without one — the
         chevron is the whole difference, and it is what says there is a list under this.

         There is no `ChevronDown` style beside it, and that is deliberate. A `Setter` holds one
         value, and the value of a `Data` setter is one `Geometry` — every `Path` taking the style
         is handed the same object, and only the first one draws. That is what the four pickers on
         the front door did: the one that sizes to its content drew a chevron and the two that
         stretch drew none, on a build with no warning in it, found by photographing the window.
         Splitting it — geometry on the element, everything else in a style — leaves the trap armed
         for whoever writes the next `Path`, so the chevron is written where it is drawn, once, and
         the shape a second one would take is this one copied. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A pill you press. The value `Pill` draws and the row rank's behaviour, in one key, because a
         filing chip on a meeting is both: it shows what the meeting is filed under and it opens that
         node's history. The corner and the padding are `Pill`'s own values rather than numbers of its
         own — a press shaped like a pill has to be the same shape as one. -->
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource RowButtonOnCard}">
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One entry of an open list. Templated for the reason the picker below is and for one more:
         the platform draws the selected entry with an accent-coloured pill down its left edge, and
         `docs/design.md` §And five things this application is not says outright that this
         application never uses the system accent colour. It has two colours and neither of them is
         Windows'. What says which entry is chosen here is the decision tint, which is what that
         page gives for **the selected option of a set**.

         The list is the application's own (`DropDown`), so an entry is a `ListViewItem` and its
         states are that control's: over and pressed are the card tint, the chosen entry is the
         decision tint whatever the pointer does. Every name a list view can go to is declared,
         because which of them a custom template is sent to is the platform's, and a name left out
         is a state change that silently draws nothing. Over and pressed are no longer the one place
         a cursor is answered: a press answers the pointer everywhere now (`HoverVeil` on the button
         templates), and this is the same answer for an entry. -->
    <Style x:Key="DropDownItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="4,0,4,0"
                        MinHeight="{TemplateBinding MinHeight}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource CardBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource CardBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverPressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource CardBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource DecisionTintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="{TemplateBinding Padding}"
                            TextWrapping="NoWrap"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The picker, as the artboards draw it: that same pill carrying its value and the chevron,
         and **no header** — what a picker chooses is said beside it, as text the screen lays out,
         which is what lets the box itself stand at the page's 34.

         The application's own control and not the platform's `ComboBox`. A `ComboBox` opens its
         list in a window the platform places, for a carousel, and three batches of patching where
         that window went were each seen on screen to have failed; this one is a pill and a popup
         constrained to the window's root, and `ListPlacement` decides where the list goes. The
         template has a part for everything `DropDown.cs` reaches by name: `Pill`, `Value`,
         `Chevron`, `HoverVeil`, `Popup`, and inside it `List`.

         The pill is veiled like every other press (`HoverVeil`, at the pointer and pressed
         strengths of `OlivoButtonTemplate`) and keeps showing what is chosen while the list is
         open — the list is a separate surface and does not cover it. Its border is bound to the
         control's own, so a screen that sets `BorderBrush` to pico on a pill with an unanswered
         question still draws its rule. The list opens and closes with no animation:
         `docs/design.md` §What moves has four entries and no drop-down among them. -->
    <Style x:Key="DropDown" TargetType="local:DropDown">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDown">
                    <Grid x:Name="LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Visibility" Value="Visible" />
                                        <Setter Target="HoverVeil.Opacity" Value="{StaticResource PointerVeilOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Visibility" Value="Visible" />
                                        <Setter Target="HoverVeil.Opacity" Value="{StaticResource PressedVeilOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Value.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="Chevron.Stroke" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- What the pill says: the chosen entry in ink, or the placeholder
                                 in tertiary ink. -->
                            <VisualStateGroup x:Name="ValueStates">
                                <VisualState x:Name="HasValue" />
                                <VisualState x:Name="Placeholder">
                                    <VisualState.Setters>
                                        <Setter Target="Value.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border
                            x:Name="Pill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True">
                            <!-- The chevron's column is a fixed width and not `Auto`. Left to size
                                 itself it measured to nothing on every picker that stretched — the
                                 two on the recording card stood with no chevron at all while the
                                 two that sized to their content had one, which a probe
                                 photographed. 11 for the mark and 12 to the pill's edge, as the
                                 artboards draw it. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="23" />
                                </Grid.ColumnDefinitions>

                                <!-- One line, trimmed at the pill's edge with an ellipsis. A device
                                     is called whatever its maker called it, and *Micrófono
                                     (Realtek(R) Audio) - High Definition Audio Device* is the
                                     length that has to fit; nothing caps the pill's width, so a
                                     name is only cut when the window is narrower than it. -->
                                <TextBlock
                                    x:Name="Value"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- Written here rather than taken off a style: a `Geometry` in a
                                     `Setter` is one object handed to every `Path` that takes it,
                                     and only the first draws. -->
                                <Path
                                    x:Name="Chevron"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="11"
                                    Height="11"
                                    Stretch="Uniform"
                                    IsHitTestVisible="False"
                                    Stroke="{ThemeResource SecondaryTextBrush}"
                                    StrokeThickness="2.2"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Data="M5 9l7 7 7-7" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="HoverVeil"
                            Background="{ThemeResource InkBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                        <!-- Constrained to the window's root and dismissed by a press outside,
                             which is what keeps the list inside the window: `DropDown.cs` hands
                             the pill's place to `ListPlacement.For` and sets this popup's offsets
                             from what comes back. -->
                        <Popup
                            x:Name="Popup"
                            ShouldConstrainToRootBounds="True"
                            IsLightDismissEnabled="True">
                            <Border
                                x:Name="ListBorder"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource PaperBrush}"
                                BorderBrush="{ThemeResource LineBrush}"
                                BorderThickness="1"
                                BackgroundSizing="InnerBorderEdge"
                                CornerRadius="{StaticResource PressedCorner}"
                                Padding="0,4,0,4">
                                <ListView
                                    x:Name="List"
                                    Background="Transparent"
                                    Padding="0"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    SingleSelectionFollowsFocus="False"
                                    ItemContainerStyle="{StaticResource DropDownItem}">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                </ListView>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One option of a set of more than two, which `docs/design.md` §Controls draws as a radio
         row: a 16px circle — genuinely round — olivo with a papel inset when chosen and a ring
         when not, and the whole chosen row sitting on the decision tint.

         Templated, and for exactly the reason `DropDownItem` above is: the platform's own
         RadioButton fills its checked circle from the accent family, and §And five things this
         application is not says outright that this application never uses the system accent
         colour. It has two colours and neither of them is the system's. A `Foreground` setter loses
         to a visual state, so the states are what had to be rewritten.

         Over and pressed are named and left empty rather than left out, and the difference is what
         a reader takes from it: §What never moves says nothing in this application answers a
         passing cursor, so both states were decided and the empty element is the record of that.
         This template replaces the platform's wholesale, so there are no inherited setters left to
         suppress — what an unnamed state would cost is only that the next person cannot tell a
         decision from an omission.

         What the platform still owns is the whole of what a radio is: the group, the keyboard, the
         automation peer and the exclusivity. Only what is drawn is Olivo's. -->
    <Style x:Key="Option" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="TheRow"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <!-- Both setters, because either circle may be the one on screen:
                                     `Chosen` is what a ticked row shows and `Ring` is what the
                                     other rows show, and a group that went dead with one of them
                                     still at full strength reads as half live. -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TheWords.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="Chosen.Fill" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="Ring.Stroke" Value="{ThemeResource EmptyControlRingBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="TheRow.Background" Value="{ThemeResource DecisionTintBrush}" />
                                        <Setter Target="Ring.Visibility" Value="Collapsed" />
                                        <Setter Target="Chosen.Visibility" Value="Visible" />
                                        <Setter Target="Inset.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Three circles and not one with a changing fill. A `Setter` inside a
                                 visual state hands every element wearing this template the same
                                 object, which is the trap the chevron above is written against, and
                                 visibility is the one property that costs nothing to say twice. -->
                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="Ring"
                                    Width="16"
                                    Height="16"
                                    Stroke="{ThemeResource UnansweredBrush}"
                                    StrokeThickness="1.5" />
                                <Ellipse
                                    x:Name="Chosen"
                                    Width="16"
                                    Height="16"
                                    Fill="{ThemeResource OliveBrush}"
                                    Visibility="Collapsed" />
                                <Ellipse
                                    x:Name="Inset"
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource PaperBrush}"
                                    Visibility="Collapsed" />
                            </Grid>

                            <ContentPresenter
                                x:Name="TheWords"
                                Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One tick of a set somebody may choose several of, which is what `Option` cannot be: a radio
         row is one of a group, and this is each of its own. The box is `Correcciones.dc.html`'s —
         18 by 18 at `PressedCorner`, a 1.5px `UnansweredBrush` ring when not ticked and an olivo
         fill with a papel check when ticked, the check being that artboard's own 11px glyph at
         stroke 3 of a 24 box. The row is `Option`'s, less what it tints: several rows can be ticked
         at once, and a tint on each would say nothing.

         Templated for the reason `Option` is: the platform's own CheckBox fills its box from the
         system accent, and §And five things this application is not says this application never
         uses it. Over and pressed are named and left empty, for the reason `Option` gives.

         What the platform still owns is the whole of what a check box is: the keyboard, the
         automation peer and `IsChecked`. Only what is drawn is Olivo's. -->
    <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="local:HandCursor.IsShown" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border
                        x:Name="TheRow"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <!-- Both the ring and the fill, because either may be the one on
                                     screen, and a tick that went dead with one of them still at full
                                     strength reads as half live. -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TheWords.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="Ticked.Background" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="Ring.BorderBrush" Value="{ThemeResource EmptyControlRingBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Visibility" Value="Collapsed" />
                                        <Setter Target="Ticked.Visibility" Value="Visible" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Visibility and never a changing fill, for the reason `Option` gives. -->
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                <Border
                                    x:Name="Ring"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="{StaticResource PressedCorner}"
                                    BorderBrush="{ThemeResource UnansweredBrush}"
                                    BorderThickness="1.5" />
                                <Border
                                    x:Name="Ticked"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="{StaticResource PressedCorner}"
                                    Background="{ThemeResource OliveBrush}"
                                    Visibility="Collapsed" />
                                <Viewbox x:Name="Check" Width="11" Height="11" Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="M5,12.5 L10,17.5 L19,7.5"
                                            Stroke="{ThemeResource PaperBrush}"
                                            StrokeThickness="3"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <ContentPresenter
                                x:Name="TheWords"
                                Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A typed field: papel, a 1px rule at the pressed corner, and the rule goes olivo while the
         caret is in it — the one answer a field gives, and it is olivo because that is what is
         alive here and not the accent colour of the system, which this design does not have. Over is
         named and empty for `docs/design.md` §What never moves.

         Templated for the same reason the pickers are: the platform's own template draws a
         thickened accent underline when focused, a different fill over a passing cursor, and a
         button that clears what was typed — three things this design does not draw, and none of
         them can be set off from outside because a visual state beats a setter. The parts are the
         platform's own, each looked up by name: `ContentElement` is where the text is edited,
         `PlaceholderTextContentPresenter` is the hint and `HeaderContentPresenter` is the header,
         which is said in the body rank in secondary ink. There is no delete part, and the control
         copes without one. -->
    <Style x:Key="TypedField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="ContentElement.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OliveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ButtonStates">
                                <VisualState x:Name="ButtonVisible" />
                                <VisualState x:Name="ButtonCollapsed" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentPresenter
                            x:Name="HeaderContentPresenter"
                            Grid.Row="0"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FontFamily="{StaticResource TextFace}"
                            FontSize="{StaticResource BodySize}"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Margin="0,0,0,6"
                            TextWrapping="Wrap"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="BorderElement"
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True"
                            MinWidth="{TemplateBinding MinWidth}"
                            Height="{StaticResource ControlHeight}" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Grid.Row="1"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                            IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            Margin="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.AccessibilityView="Raw"
                            ZoomMode="Disabled" />
                        <TextBlock
                            x:Name="PlaceholderTextContentPresenter"
                            Grid.Row="1"
                            Foreground="{ThemeResource TertiaryTextBrush}"
                            Margin="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Text="{TemplateBinding PlaceholderText}"
                            VerticalAlignment="Center"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextWrapping="{TemplateBinding TextWrapping}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A typed field for a secret: the same field as `TypedField`, showing dots. The platform's
         eye that reveals what was typed is turned off in the style and not on the screen, because
         a secret on screen is a secret in whatever recorded that screen — and a meeting
         application is the one kind of application whose screen somebody is often sharing. The
         template has no reveal part at all, so the eye cannot come back by a setter either; the
         mode stays set for whoever reads the style. -->
    <Style x:Key="TypedSecret" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFace}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PressedCorner}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="PasswordRevealMode" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                        <Setter Target="ContentElement.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OliveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ButtonStates">
                                <VisualState x:Name="ButtonVisible" />
                                <VisualState x:Name="ButtonCollapsed" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentPresenter
                            x:Name="HeaderContentPresenter"
                            Grid.Row="0"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FontFamily="{StaticResource TextFace}"
                            FontSize="{StaticResource BodySize}"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Margin="0,0,0,6"
                            TextWrapping="Wrap"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="BorderElement"
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True"
                            Height="{StaticResource ControlHeight}" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Grid.Row="1"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                            IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                            Margin="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            ZoomMode="Disabled"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock
                            x:Name="PlaceholderTextContentPresenter"
                            Grid.Row="1"
                            Foreground="{ThemeResource TertiaryTextBrush}"
                            Margin="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Text="{TemplateBinding PlaceholderText}"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dialogue: the one thing that interrupts the screen, so the one place the larger corner
         is used. `docs/design.md` §Notices and §Two places: the act is on the right and what loses
         nothing is on the left, which is the other way round from the platform's, so the command
         row is rebuilt rather than restyled.

         The platform's states and the parts it looks up by name are all kept — the sizing and the
         buttons' visibility are the control's own code, and the showing and hiding fade is kept but
         not the platform's zoom (nothing in this design scales) — and
         what is replaced is what is drawn: papel for the ground and the rule, the title at the
         sub-screen rank, the two presses through the styles this file already has.

         `DefaultButtonStates` is named and left empty on purpose. The platform's
         `PrimaryAsDefaultButton` sets `AccentButtonStyle`, the system accent this design refuses,
         and a dialogue that sets a default button would otherwise bring it back through the one
         door this file does not draw. The smoke behind the dialogue stays the platform's: the
         design's `rgba(28,27,25,.32)` carries an alpha that a key here cannot hold, and the tests
         read six-digit colours only. -->
    <Style x:Key="Notice" TargetType="ContentDialog">
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="{ThemeResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource InterruptionCorner}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource NormalButtonOnPaper}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource NormalButtonOnPaper}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource ButtonAtTheMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentDialog">
                    <Border x:Name="Container">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DialogShowingStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="DialogHidden">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="False" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="DialogShowing">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="DialogHidden" />
                                <VisualState x:Name="DialogShowing">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                                        <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                                        <Setter Target="CloseButton.IsTabStop" Value="True" />
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                        <Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="DialogShowingWithoutSmokeLayer">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                                        <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                                        <Setter Target="CloseButton.IsTabStop" Value="True" />
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                        <Setter Target="LayoutRoot.Background" Value="{x:Null}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DialogSizingStates">
                                <VisualState x:Name="DefaultDialogSizing" />
                                <VisualState x:Name="FullDialogSizing">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundElement.VerticalAlignment" Value="Stretch" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- The close press is column 0 and the primary one column 4, so what
                                 loses nothing is on the left and the act on the right whichever of
                                 them are shown. The secondary press sits between and is the only
                                 one that needs a gap of its own. -->
                            <VisualStateGroup x:Name="ButtonsVisibilityStates">
                                <VisualState x:Name="AllVisible">
                                    <VisualState.Setters>
                                        <Setter Target="FirstSpacer.Width" Value="{ThemeResource ContentDialogButtonSpacing}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NoneVisible">
                                    <VisualState.Setters>
                                        <Setter Target="CommandSpace.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PrimaryVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SecondaryVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SecondaryButton.(Grid.Column)" Value="4" />
                                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CloseVisible">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PrimaryAndSecondaryVisible">
                                    <VisualState.Setters>
                                        <Setter Target="FirstSpacer.Width" Value="{ThemeResource ContentDialogButtonSpacing}" />
                                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PrimaryAndCloseVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SecondaryAndCloseVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SecondaryButton.(Grid.Column)" Value="4" />
                                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- Named and empty, for the reason this style's remark gives. -->
                            <VisualStateGroup x:Name="DefaultButtonStates">
                                <VisualState x:Name="NoDefaultButton" />
                                <VisualState x:Name="PrimaryAsDefaultButton" />
                                <VisualState x:Name="SecondaryAsDefaultButton" />
                                <VisualState x:Name="CloseAsDefaultButton" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DialogBorderStates">
                                <VisualState x:Name="NoBorder" />
                                <VisualState x:Name="AccentColorBorder" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="LayoutRoot" Visibility="Collapsed">
                            <Rectangle x:Name="SmokeLayerBackground" Fill="{ThemeResource ContentDialogSmokeFill}" />
                            <Border
                                x:Name="BackgroundElement"
                                Background="{TemplateBinding Background}"
                                FlowDirection="{TemplateBinding FlowDirection}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BackgroundSizing="InnerBorderEdge"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinWidth="{ThemeResource ContentDialogMinWidth}"
                                MaxWidth="{ThemeResource ContentDialogMaxWidth}"
                                MinHeight="{ThemeResource ContentDialogMinHeight}"
                                MaxHeight="{ThemeResource ContentDialogMaxHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid x:Name="DialogSpace" CornerRadius="{StaticResource InterruptionCorner}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer
                                        x:Name="ContentScrollViewer"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        ZoomMode="Disabled"
                                        IsTabStop="False">
                                        <Grid Padding="{ThemeResource ContentDialogPadding}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <ContentControl
                                                x:Name="Title"
                                                Margin="0,0,0,16"
                                                Content="{TemplateBinding Title}"
                                                ContentTemplate="{TemplateBinding TitleTemplate}"
                                                FontFamily="{StaticResource TextFace}"
                                                FontSize="{StaticResource SubScreenTitleSize}"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                IsTabStop="False">
                                                <ContentControl.Template>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            MaxLines="2"
                                                            TextWrapping="Wrap"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            Margin="{TemplateBinding Padding}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </ContentControl.Template>
                                            </ContentControl>
                                            <ContentPresenter
                                                x:Name="Content"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Content="{TemplateBinding Content}"
                                                FontFamily="{StaticResource TextFace}"
                                                FontSize="{StaticResource BodySize}"
                                                Foreground="{TemplateBinding Foreground}"
                                                Grid.Row="1"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Close on the left, the act on the right. -->
                                    <Grid
                                        x:Name="CommandSpace"
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        XYFocusKeyboardNavigation="Enabled"
                                        Padding="{ThemeResource ContentDialogPadding}"
                                        Background="{TemplateBinding Background}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="CloseColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="SecondSpacer" Width="*" />
                                            <ColumnDefinition x:Name="SecondaryColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="FirstSpacer" Width="0" />
                                            <ColumnDefinition x:Name="PrimaryColumn" Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="CloseButton"
                                            Grid.Column="0"
                                            IsTabStop="False"
                                            Content="{TemplateBinding CloseButtonText}"
                                            Style="{TemplateBinding CloseButtonStyle}"
                                            ElementSoundMode="FocusOnly" />
                                        <Button
                                            x:Name="SecondaryButton"
                                            Grid.Column="2"
                                            IsTabStop="False"
                                            Content="{TemplateBinding SecondaryButtonText}"
                                            IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                            Style="{TemplateBinding SecondaryButtonStyle}"
                                            ElementSoundMode="FocusOnly" />
                                        <Button
                                            x:Name="PrimaryButton"
                                            Grid.Column="4"
                                            IsTabStop="False"
                                            Content="{TemplateBinding PrimaryButtonText}"
                                            IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                            Style="{TemplateBinding PrimaryButtonStyle}"
                                            ElementSoundMode="FocusOnly" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- `docs/design.md` §Controls also draws a two-way choice — two halves inside a `#E6E4DE`
         trough — and there is nothing for it here, because nothing in the application offers a
         choice of two yet. The one screen that wanted the shape wanted it for an answer that
         cannot be given: whichever card makes *en vivo* against *al terminar* pressable brings the
         trough with it, and the page has the six numbers it needs. A dictionary entry a screen
         cannot honestly use is a shape somebody reaches for because it is there. -->

</ResourceDictionary>
