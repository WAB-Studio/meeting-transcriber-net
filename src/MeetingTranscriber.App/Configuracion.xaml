<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeetingTranscriber.App.Configuracion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A press that stands beside a typed field is the field's height, so the two read as one
             row: the field is `ControlHeight` and its press was the taller normal button. -->
        <Style x:Key="ButtonBesideAField" TargetType="Button" BasedOn="{StaticResource NormalButtonOnCard}">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        </Style>

        <!-- *Quitar* loses something, so it is drawn as a press and not as a word: the row rank
             at the margin, past the gap, with the 1px rule `IconButton` carries. -->
        <Style x:Key="TheKeysRemovePress" TargetType="Button" BasedOn="{StaticResource RowButtonThatLosesSomething}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource EmptyControlRingBrush}" />
        </Style>

        <!-- The export is a glyph and its name and tooltip are set where the press is drawn: it
             says what it does on hover and to a screen reader, and shows no word. -->
        <Style x:Key="TheExportGlyph" TargetType="Button" BasedOn="{StaticResource IconButton}" />
    </UserControl.Resources>

    <!-- The one screen that lives apart, and everything on it is an answer about this install
         rather than about the next meeting. Every block is a card with its own heading: what
         should happen after a recording, the two engines (the summarising one with the model it
         is asked of), the Deepgram key the first of them spends, who is using the application
         and in which language, the folder the meetings live in, what an export takes out of it,
         and where Claude Code is. The artboard draws no key; it sits under the engine cards
         because that engine is what it is for.

         Choosing between transcribing and summarising stopped being a question per meeting and
         became a preference set once, so it is asked here, before any recording, and nothing
         asks again — which is what makes the presses on a meeting's own row load-bearing rather
         than a convenience.

         The same screen is the first step: while nobody has said who is using the application it
         opens with only the cards needed to begin (after recording, the two
         engines, the Deepgram key, your name), a *Get started* title and *Start* to leave it — not
         a second drawing of blocks this screen already has. `Configuracion.Open` decides it, and the press at the foot of the
         window always opens the whole of it.

         A sub-screen of the window and not a window of its own, the way the meeting screen and
         the filing screen are: it is reached from the word at the foot of the front door, left
         through the window's app bar, and a meeting under way keeps its strip above it for the
         whole of that. -->

    <Grid x:Name="Root" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header, in the shape the meeting screen's is. Left through `GoBack`, which the
             window's app bar calls. -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind In(loc:UiTexts.Settings)}"
                Style="{StaticResource SubScreenTitleText}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                <!-- What happens when a recording ends: three options, one chosen, on tarjeta. A
                     set of more than two is a radio row, and every part of how one is drawn is
                     Olivo's `Option`.

                     The group goes dead when the corpus is not reachable: the answer has nowhere
                     to be kept, the refusal is already on screen naming the folder, and a press
                     that would fail is worse than one that is plainly not available. It is never
                     dead for a write in flight: a choice made meanwhile is written after it. -->
                <Border Style="{StaticResource Card}" Padding="{StaticResource LargeCardPadding}">
                    <RadioButtons
                        x:Name="AfterARecordingOptions"
                        Header="{x:Bind In(loc:UiTexts.WhenARecordingEnds)}">
                        <RadioButton
                            x:Name="AfterTranscribeAndSummarise"
                            Style="{StaticResource Option}"
                            Checked="OnAfterARecordingChosen"
                            Content="{x:Bind In(loc:UiTexts.TranscribeItAndSummariseIt)}" />
                        <RadioButton
                            x:Name="AfterTranscribe"
                            Style="{StaticResource Option}"
                            Checked="OnAfterARecordingChosen"
                            Content="{x:Bind In(loc:UiTexts.OnlyTranscribeIt)}" />
                        <RadioButton
                            x:Name="AfterNothing"
                            Style="{StaticResource Option}"
                            Checked="OnAfterARecordingChosen"
                            Content="{x:Bind In(loc:UiTexts.DoNothingWhenItEnds)}" />
                    </RadioButtons>
                </Border>

                <!-- The two engines, side by side, each on its own card because they are charged
                     separately: if one of the two fails the other is already done and is not paid
                     for again.

                     Written out and not built from a list: `docs/design.md` says a model on this
                     machine is one more row in both lists, and one more row here is one more pair
                     of lines. A loop over a list of one would be preparation for a shape nobody
                     has drawn. Transcribing has no choice to make; summarising has the model it
                     is asked of, once for every meeting. -->
                <Grid x:Name="EnginesRow" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.TranscribeWith)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.TheEngineThatTranscribes)}"
                                Style="{StaticResource BodyText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.SummariseWith)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.TheEngineThatSummarises)}"
                                Style="{StaticResource BodyText}" />

                            <!-- How this engine is paid, said under its name and before anything is
                                 chosen from it: it runs on the person's own Claude plan, because the
                                 application strips every API key before it starts one, so no figure
                                 is shown and none is spent from here. -->
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.OnYourClaudePlan)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />

                            <!-- Written the moment it is chosen, through the one gate every write
                                 on this screen goes through, and dead with the group above it when
                                 there is nowhere to write. -->
                            <ComboBox
                                x:Name="SummaryModelPicker"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                Style="{StaticResource DropDown}"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.SummariseWith)}"
                                SelectionChanged="OnSummaryModelChosen" />

                            <!-- How much reasoning the summary is asked to spend, beside its own
                                 label for the reason the language's is, and written the way the
                                 model is. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind In(loc:UiTexts.Effort)}"
                                    Style="{StaticResource BodyText}"
                                    Foreground="{ThemeResource SecondaryTextBrush}" />
                                <ComboBox
                                    x:Name="EffortPicker"
                                    MinWidth="120"
                                    Style="{StaticResource DropDown}"
                                    AutomationProperties.Name="{x:Bind In(loc:UiTexts.Effort)}"
                                    SelectionChanged="OnSummaryEffortChosen" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The Deepgram key this machine transcribes with, right under the engine that
                     spends it. Until this block the only way to put one here was a terminal, so
                     somebody who installed the application could record and never transcribe.

                     The field is a secret field and is emptied after every press, kept or refused:
                     what was pasted is never on screen as characters and does not stay in the
                     control. The line under it says whether a key is kept and nothing else about
                     it — no length, no last four characters — because the screen cannot read the
                     key at all: everything here goes through `KeepingThisMachinesKey`, which has
                     no read.

                     *Quitar* loses something — Deepgram shows a key once, so it is often not one
                     somebody can paste again — so it takes the rank that says so, at the margin,
                     and sits on the line saying a key is kept rather than on *Guardar*'s row: the
                     gap `docs/design.md` asks for between an act and what loses something is a
                     whole line here. It is drawn while a key may be there to take away. -->
                <Border Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.DeepgramKeyHeader)}"
                            Style="{StaticResource BodyText}"
                            Foreground="{ThemeResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox
                                x:Name="DeepgramKeyBox"
                                MinWidth="320"
                                Style="{StaticResource TypedSecret}"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.DeepgramKeyHeader)}"
                                PasswordChanged="OnDeepgramKeyTyped" />
                            <Button
                                x:Name="KeepTheKeyButton"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource ButtonBesideAField}"
                                Click="OnKeepTheKey"
                                IsEnabled="False"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.SaveTheDeepgramKey)}"
                                Content="{x:Bind In(loc:UiTexts.Save)}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="DeepgramKeyText"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <Button
                                x:Name="RemoveTheKeyButton"
                                VerticalAlignment="Center"
                                Style="{StaticResource TheKeysRemovePress}"
                                Click="OnRemoveTheKey"
                                Visibility="Collapsed"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.RemoveTheDeepgramKey)}"
                                Content="{x:Bind In(loc:UiTexts.Remove)}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Who is using the application. It is one field and one press whether it is being
                     answered for the first time or corrected afterwards, and the press stands at the
                     field's height so the two read as one row. The affiliation the design asks about
                     is not here and is not missing: `docs/design.md` says the first screen of an
                     application is not where somebody enumerates their jobs, and the `Persona`
                     dialogue is where one is added. -->
                <Border Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.You)}"
                            Style="{StaticResource BodyText}"
                            Foreground="{ThemeResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="WhoIsUsingThisBox"
                                MinWidth="240"
                                Style="{StaticResource TypedField}"
                                Header="{x:Bind In(loc:UiTexts.WhoIsUsingTheApplication)}"
                                TextChanged="OnWhoIsUsingThisTyped" />
                            <Button
                                x:Name="WhoIsUsingThisButton"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource ButtonBesideAField}"
                                Click="OnKeepWhoIsUsingThis"
                                Content="{x:Bind In(loc:UiTexts.Save)}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How the application itself reads and looks, which is not about who is using it:
                     the language it is **read** in, which is not the language a meeting is spoken in
                     (that one is on the recording card, beside what it is about), and the theme it
                     is drawn in. Both are answers about this install, and neither is needed to begin, so the
                     card stands in the whole screen and not in the first step.

                     Each label is beside its picker and not over it: a picker is a pill and a pill
                     carries no header, so what it chooses is said as text. That text is also what a
                     screen reader is given, by name. -->
                <Border x:Name="AppCard" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.App)}"
                            Style="{StaticResource BodyText}"
                            Foreground="{ThemeResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind In(loc:UiTexts.Language)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <ComboBox
                                x:Name="LanguagePicker"
                                MinWidth="150"
                                Style="{StaticResource DropDown}"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.Language)}"
                                SelectionChanged="OnLanguageChosen" />

                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind In(loc:UiTexts.Theme)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <ComboBox
                                x:Name="ThemePicker"
                                MinWidth="150"
                                Style="{StaticResource DropDown}"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.Theme)}"
                                SelectionChanged="OnThemeChosen" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The folder the meetings live in, as data, and which folder was refused when
                     there is nowhere. This is the only line in the application that says which
                     refusal it was, and the meetings list's own sentence —
                     `UiTexts.TheCorpusCouldNotBeOpened` — sends somebody to this screen for it.

                     *Cambiar* is beside it, and only when the corpus was refused: a corpus that
                     opened is moved by moving the files and then saying so, and no screen offers
                     the first half. -->
                <Border x:Name="FolderCard" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.Folder)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <TextBlock
                                x:Name="CorpusText"
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Name="ChangeWhereItIsKept"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PillButton}"
                            Click="OnChangeWhereItIsKept"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{x:Bind In(loc:UiTexts.ChangeWhereTheCorpusIsKept)}"
                            Content="{x:Bind In(loc:UiTexts.Change)}" />
                    </Grid>
                </Border>

                <!-- Taking the meetings out: four ticks for what goes, and the press. Every tick
                     starts ticked, because the whole package is what somebody asking to take their
                     data out expects, and nothing ticked leaves the press dead. The press is at the
                     normal rank and is not this screen's principal act; there is no sentence when
                     it worked, because the line beside it changing is what says so. The line names
                     when the last one was made, what it took and where it went, and is drawn only
                     once there has been one. The press is dead exactly where the corpus is, since
                     there is nothing to take out of a corpus that will not open. -->
                <Border x:Name="ExportCard" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.Export)}"
                            Style="{StaticResource BodyText}"
                            Foreground="{ThemeResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox
                                x:Name="ExportAudio"
                                Style="{StaticResource Tick}"
                                IsChecked="True"
                                Checked="OnExportTicked"
                                Unchecked="OnExportTicked"
                                Content="{x:Bind In(loc:UiTexts.ExportsAudio)}" />
                            <CheckBox
                                x:Name="ExportTranscripts"
                                Style="{StaticResource Tick}"
                                IsChecked="True"
                                Checked="OnExportTicked"
                                Unchecked="OnExportTicked"
                                Content="{x:Bind In(loc:UiTexts.ExportsTranscripts)}" />
                            <CheckBox
                                x:Name="ExportSummaries"
                                Style="{StaticResource Tick}"
                                IsChecked="True"
                                Checked="OnExportTicked"
                                Unchecked="OnExportTicked"
                                Content="{x:Bind In(loc:UiTexts.ExportsSummaries)}" />
                            <CheckBox
                                x:Name="ExportHandCorrections"
                                Style="{StaticResource Tick}"
                                IsChecked="True"
                                Checked="OnExportTicked"
                                Unchecked="OnExportTicked"
                                Content="{x:Bind In(loc:UiTexts.ExportsHandCorrections)}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="LastExportText"
                                Grid.Column="0"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <!-- A glyph, so its name and its tooltip are set in `ShowTheExport`
                                 with the rest of what changes while an export runs. -->
                            <Button
                                x:Name="ExportButton"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource TheExportGlyph}"
                                Click="OnExport">
                                <FontIcon Glyph="&#xE896;" FontSize="{StaticResource BodySize}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Where Claude Code is, the last block this screen carries. The data line names
                     the executable somebody chose, or nothing when nobody has — the search of
                     `PATH` that stands in for that has no line of its own. The sentence beneath it
                     is drawn when Claude Code is not on this machine or did not answer, and after
                     *Probar* when it did: silence is what "it is there" gets until somebody asks.

                     *Cambiar* is always offered, unlike the folder one: there is no refused state
                     to wait for. Where two presses show the same word they are told apart for a
                     screen reader by `AutomationProperties.Name`. -->
                <Border x:Name="ClaudeCodeCard" Style="{StaticResource Card}" Padding="{StaticResource SmallCardPadding}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock
                                Text="{x:Bind In(loc:UiTexts.TheEngineThatSummarises)}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <TextBlock
                                x:Name="ClaudeCodeText"
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ClaudeCodeStatusText"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top">
                            <Button
                                x:Name="TestClaudeCodeButton"
                                Style="{StaticResource PillButton}"
                                Click="OnTestClaudeCode"
                                Content="{x:Bind In(loc:UiTexts.Test)}" />
                            <Button
                                x:Name="ChangeWhereClaudeCodeIs"
                                Style="{StaticResource PillButton}"
                                Click="OnChangeWhereClaudeCodeIs"
                                AutomationProperties.Name="{x:Bind In(loc:UiTexts.ChangeWhereClaudeCodeIs)}"
                                Content="{x:Bind In(loc:UiTexts.Change)}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Said where it happened rather than in a notice, which is what the filing screen already
             does: an answer that was refused is a thing about this screen, and the two the design
             allows to stop a screen are a charge and adding a person. *Empezar* is the principal
             act of the first step and is on screen only there. -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Foreground="{ThemeResource PeakBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Button
                x:Name="StartButton"
                Grid.Column="1"
                Style="{StaticResource PrincipalActButton}"
                Click="OnStart"
                Visibility="Collapsed"
                Content="{x:Bind In(loc:UiTexts.Start)}" />
        </Grid>
    </Grid>
</UserControl>
