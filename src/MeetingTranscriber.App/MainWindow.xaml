<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingTranscriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         No value chosen on the screen either, which is the same rule applied to what it looks
         like: every colour, text size and corner here names a key in Olivo.xaml, and OlivoTests
         fails the build over a hex value, a font size or a corner radius typed in. `docs/design.md`
         is the authority, and this is the screen that settled those keys — it was the first to need
         them, so every screen after this one uses these names rather than proposing its own.

         Which controls are live is not decided here either. Every one of them is set from a
         RecorderScreen in the code-behind, which is the one thing that answers that question and
         the one thing a build agent can run.

         The whole screen in two halves: what the next meeting will record, above, and the meetings
         already recorded, below. One window and not two, because the second is what somebody comes
         back to the application for and a list behind a button is a list nobody opens. The drawer
         raises itself to the whole window, at which point the half above travels out of the way
         rather than vanishing — 300 ms, accelerating out, and nothing at all on a machine that
         asked Windows for no animation. How long that is worth is Movement's, in a project a build
         agent runs against both answers; what moves is ScreenMotion's. -->

    <!-- Papel, and opaque. `docs/design.md` §And five things this application is not: never mica or
         acrylic, because a translucent window is one where nothing weighs anything. What was here
         was the platform's Mica backdrop. -->
    <Grid
        Background="{StaticResource PaperBrush}"
        Padding="{StaticResource ScreenPadding}"
        RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="RecordingCard" Grid.Row="0" Spacing="18">
            <!-- What the next meeting will record and the presses that run it. It goes as one
                 thing while the meeting is being saved, because none of it is answerable then:
                 every control in it is dead, and a dead screen headed "record a meeting" over a
                 meeting being saved is a window that looks like it lost the one it just had. -->
            <StackPanel x:Name="TheNextMeeting" Spacing="18">
                <TextBlock Text="{x:Bind In(loc:UiTexts.RecordAMeeting)}" Style="{StaticResource ScreenTitleText}" />

                <!-- What the next meeting will record. Everything here is dead the moment one starts:
                     changing the microphone half way through is not a thing the engine can do, so it is
                     not a thing this screen offers. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="MicrophonePicker"
                        MinWidth="240"
                        Style="{StaticResource DropDown}"
                        Header="{x:Bind In(loc:UiTexts.Microphone)}"
                        SelectionChanged="OnMicrophoneChosen" />
                    <ComboBox
                        x:Name="SourcePicker"
                        MinWidth="280"
                        Style="{StaticResource DropDown}"
                        Header="{x:Bind In(loc:UiTexts.WhatToRecordFromThisMachine)}"
                        SelectionChanged="OnSourceChosen">
                        <!-- The one picker that says which panel holds it, and the only one long
                             enough for it to matter: this list is every program on the machine, and a
                             ComboBox's own CarouselPanel decides where a list too long to fit opens.
                             With nothing chosen it opened part way down the alphabet, so the answer
                             that is always available and always right about what it records — the
                             whole machine, put first by SourcesNow for exactly that reason — was not
                             on screen when the list was, and the first thing somebody saw was a
                             service they have never heard of. A linear panel opens at the top, and
                             still draws only what fits. What should change is the list being this
                             long at all, which is not this card's. -->
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <Button
                        x:Name="RefreshTheMachineButton"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource NormalButtonOnPaper}"
                        Click="OnRefreshTheMachine"
                        Content="{x:Bind In(loc:UiTexts.RefreshTheList)}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Spacing="2">
                        <ComboBox
                            x:Name="SpokenPicker"
                            MinWidth="240"
                            Style="{StaticResource DropDown}"
                            Header="{x:Bind In(loc:UiTexts.WhatWillBeSpoken)}"
                            SelectionChanged="OnSpokenChosen" />
                        <!-- Quieter by colour and never by opacity. `docs/design.md` gives three
                             inks and opacity is not one of them: text faded to 70 per cent is a
                             fourth grey nobody chose, and it is a different fourth grey over every
                             surface it lands on. Every `Opacity` on this screen was one of those. -->
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.WhatWillBeSpokenIsAskedEveryTime)}"
                            Style="{StaticResource BodyText}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            MaxWidth="360"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguagePicker"
                        MinWidth="160"
                        VerticalAlignment="Top"
                        Style="{StaticResource DropDown}"
                        Header="{x:Bind In(loc:UiTexts.Language)}"
                        SelectionChanged="OnLanguageChosen" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- The one thing this screen is for takes the principal rank, and nothing else
                         on the screen does: `docs/design.md` §Controls says a screen has at most one
                         of the first. The three beside it steer a recording that is already running
                         rather than being what the screen is asking for, so they are normal. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RecordButton"
                            Style="{StaticResource PrincipalActButton}"
                            Click="OnRecord"
                            Content="{x:Bind In(loc:UiTexts.Record)}" />
                        <Button
                            x:Name="PauseButton"
                            Style="{StaticResource NormalButtonOnPaper}"
                            Click="OnPause"
                            Content="{x:Bind In(loc:UiTexts.Pause)}" />
                        <Button
                            x:Name="ResumeButton"
                            Style="{StaticResource NormalButtonOnPaper}"
                            Click="OnResume"
                            Content="{x:Bind In(loc:UiTexts.Resume)}" />
                        <Button
                            x:Name="StopButton"
                            Style="{StaticResource NormalButtonOnPaper}"
                            Click="OnStop"
                            Content="{x:Bind In(loc:UiTexts.Stop)}" />
                    </StackPanel>

                    <!-- The offer, and it is not on screen until the recording has made it. That is the
                         whole of the consent here: there is nothing to press early, so nothing pressed
                         early can be spent on it.

                         Not pico, and `docs/design.md` §NadaLlego says why in as many words: taking
                         the whole machine costs nothing and loses nothing. It is the act on a
                         notice, and an act on a notice takes the normal rank. -->
                    <StackPanel x:Name="WholeMachineOffer" Spacing="4" Visibility="Collapsed">
                        <TextBlock
                            Text="{x:Bind In(loc:UiTexts.NothingCameFromThatProgram)}"
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                        <Button
                            x:Name="WholeMachineButton"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NormalButtonOnPaper}"
                            Click="OnRecordTheWholeMachine"
                            Content="{x:Bind In(loc:UiTexts.RecordTheWholeMachine)}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Saving the meeting: the state the screen is in between stop and the meeting being
                 there. It is a state and not a moment — for a long meeting the spools take minutes
                 to become a recording — so it has a heading of its own and the steps of the save
                 under it. There is no notice about leaving the application alone, deliberately: a
                 save the process did not survive leaves the spools recovery already offers.

                 The steps are built in the code-behind and not templated here, for the reason the
                 meeting cards are: which of them exist is an answer, not a layout. What decides it
                 is SavingTheMeeting, in a project a build agent can run.

                 It says what the save is doing and never how long the meeting was. The length is
                 not known here — it comes out of pouring the spools onto a timeline, which is most
                 of what this state is waiting for — so a number beside this heading could only be
                 a guess, standing seconds before the report states the answer. One meeting, one
                 length, said once. -->
            <StackPanel x:Name="SavingCard" Spacing="12" Visibility="Collapsed">
                <TextBlock
                    Text="{x:Bind In(loc:UiTexts.SavingTheMeeting)}"
                    Style="{StaticResource ScreenTitleText}" />

                <StackPanel x:Name="SavingSteps" Spacing="8" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- How long the meeting has been going, and the biggest thing on the screen while one
                 is: it is what somebody glances up at to know where the meeting has got to. On
                 screen for exactly as long as the meters are, paused included, and answered by
                 RecordingClock in a project a build agent can run rather than decided here.

                 The stopwatch rank, and the only thing on any screen set at 62. It is also the one
                 thing `docs/design.md` §What never moves names outright: a number that animates
                 between two values is unreadable at exactly the moment somebody is reading it.

                 Not a live region, and that is a decision rather than an omission. It changes
                 every second, so announcing it would talk over every line beside it — including
                 the ones about a device dying, which are the only things on this screen worth
                 interrupting somebody for.

                 HelpText and not Name, which on a TextBlock are not two ways of saying the same
                 thing: a TextBlock's automation name is its own text, and setting Name replaces it
                 rather than labelling it — so the biggest number on the screen would be read out
                 as the words "how long the meeting has been running" and never as a length. A
                 meter labels itself that way because the bar carries the name; this has nothing
                 but its text. -->
            <TextBlock
                x:Name="TheClock"
                Style="{StaticResource StopwatchText}"
                Visibility="Collapsed"
                AutomationProperties.HelpText="{x:Bind In(loc:UiTexts.HowLongTheMeetingHasBeenRunning)}" />

            <!-- What is arriving, while it is arriving. There is no meeting to meter until one is
                 being recorded, so none of this is on screen before that and none of it is left
                 standing after — a meter showing its last reading is a screen saying a recording is
                 still going. Which is not decided here: RecordingMeters answers it, in a project a
                 build agent can run, and this reads the answer onto controls.

                 Two channels and not a list, because two is the contract: channel 0 is the loopback
                 and channel 1 is the microphone, and a recording that disagreed with that would be
                 refused long before it reached a screen.

                 Each is a ChannelMeter and no longer a ProgressBar. `docs/design.md` §The meter is
                 the one component in this application that cannot be copied from anywhere, and a
                 progress bar has none of it: no hot zone standing there before anything clips, no
                 scale under the bar, and no retained peak — so nothing on it said whether −16 was
                 close to clipping or nowhere near it. -->
            <StackPanel x:Name="Meters" Spacing="18" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <local:ChannelMeter x:Name="OthersMeter" />
                    <!-- A live region, because a device dying is an event and not something to find by
                         looking — and its words are deliberately not here. A line bound in the XAML is
                         set once while this panel is collapsed and never changes again, which is a
                         live region that announces nothing: MainWindow.Tell is what says these
                         and why, and LiveRegionTests fails if one is bound here or never told. -->
                    <TextBlock
                        x:Name="OthersStopped"
                        Style="{StaticResource BodyText}"
                        Foreground="{StaticResource PeakBrush}"
                        AutomationProperties.LiveSetting="Assertive"
                        TextWrapping="Wrap"
                        MaxWidth="640"
                        Visibility="Collapsed" />
                    <!-- A channel that changed what it is on mid meeting, which is an event for the
                         same reason a device dying is: the label above it changes quietly, and what
                         the recording holds from here on is another source. Told, not bound. -->
                    <TextBlock
                        x:Name="OthersMoved"
                        Style="{StaticResource BodyText}"
                        Foreground="{StaticResource PeakBrush}"
                        AutomationProperties.LiveSetting="Assertive"
                        TextWrapping="Wrap"
                        MaxWidth="640"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <local:ChannelMeter x:Name="MineMeter" />
                    <!-- Told, not bound, for the reason channel 0's line says. -->
                    <TextBlock
                        x:Name="MineStopped"
                        Style="{StaticResource BodyText}"
                        Foreground="{StaticResource PeakBrush}"
                        AutomationProperties.LiveSetting="Assertive"
                        TextWrapping="Wrap"
                        MaxWidth="640"
                        Visibility="Collapsed" />
                    <!-- Told, not bound, for the reason channel 0's line says. -->
                    <TextBlock
                        x:Name="MineMoved"
                        Style="{StaticResource BodyText}"
                        Foreground="{StaticResource PeakBrush}"
                        AutomationProperties.LiveSetting="Assertive"
                        TextWrapping="Wrap"
                        MaxWidth="640"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Beside the meters and not in the report: it is true of the whole meeting rather
                     than of a moment in it, and a line that scrolled away would be read once. -->
                <TextBlock
                    x:Name="HeardTwice"
                    Style="{StaticResource BodyText}"
                    Foreground="{StaticResource PeakBrush}"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap"
                    MaxWidth="640"
                    Visibility="Collapsed" />
            </StackPanel>

        </StackPanel>

        <!-- Outside the half above, and bounded rather than left to take what is going. Outside
             because a line saying the chosen microphone has gone is written while the drawer may
             have the whole window, and a report that went with the recorder would be a screen
             saying nothing at the moment it had something to say. Bounded because the meetings own
             the room that is left, and a report that grew into it would push the list off the
             screen a line at a time. -->
        <StackPanel Grid.Row="1" Spacing="8">
            <!-- Who is using the application, beside where their meetings are kept: both are
                 answers about this install rather than about the next meeting, which is why they
                 are here and not up with the pickers. It is one field and one press whether it is
                 being answered for the first time or corrected afterwards — the asking is the
                 sentence under it, which is on screen exactly while nobody has answered.

                 It lives here until the settings screen exists, and then it moves there with the
                 language and this line: #108 is the card, and the row it is built around is this
                 one. The affiliation the design asks about is not here and is not missing —
                 `docs/design.md` says the first screen of an application is not where somebody
                 enumerates their jobs, and the `Persona` dialogue is where one is added. -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="WhoIsUsingThisBox"
                        MinWidth="240"
                        Style="{StaticResource TypedField}"
                        Header="{x:Bind In(loc:UiTexts.WhoIsUsingTheApplication)}"
                        TextChanged="OnWhoIsUsingThisTyped" />
                    <Button
                        x:Name="WhoIsUsingThisButton"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource NormalButtonOnPaper}"
                        Click="OnKeepWhoIsUsingThis"
                        Content="{x:Bind In(loc:UiTexts.Save)}" />
                </StackPanel>

                <TextBlock
                    x:Name="NobodyHasSaidYet"
                    Text="{x:Bind In(loc:UiTexts.NobodyHasSaidWhoIsUsingThis)}"
                    Style="{StaticResource BodyText}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap"
                    MaxWidth="640"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Where the meetings go, and which folder was refused when there is nowhere. Outside
                 the half above for the reason the report below it is: the drawer may take the
                 window while there is no corpus — nothing is being recorded then and nothing can
                 be — and this is the only line in the application that says which refusal it was.
                 The drawer's own line says the corpus could not be opened and sends somebody here
                 for why, so a screen that let this go with the recorder would be answering that
                 with an empty window.

                 A sentence, and so the body rank in a quieter ink. The path inside it is data and
                 the line around it is not — `docs/design.md` §Type: text never goes in mono, and a
                 number that is part of a sentence is text. Set at the data rank this read as a
                 whole line of code, which is what mono says about anything it is given. -->
            <TextBlock
                x:Name="CorpusText"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="180">
                <TextBlock
                    x:Name="OutputText"
                    Style="{StaticResource BodyText}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>

        <local:MeetingsDrawer x:Name="Meetings" Grid.Row="2" />

        <!-- One meeting, read in the room the list was using. The same screen and not another
             window: a meeting is reached from the list and returns to it, and a second window
             would be one more thing to find again — which is the same argument that keeps the list
             itself out of one. Which of the two is on screen is answered in the code-behind, where
             the drawer already says which position it is in. -->
        <local:ReadingAMeeting x:Name="Reading" Grid.Row="2" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="PackagingChecksButton"
                Style="{StaticResource ButtonAtTheMargin}"
                Click="OnOpenPackagingChecks"
                Content="{x:Bind In(loc:UiTexts.PackagingChecks)}" />
        </StackPanel>
    </Grid>
</Window>
