<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingTranscriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in.

         No value chosen on the screen either, which is the same rule applied to what it looks
         like: every colour, text size and corner here names a key in Olivo.xaml, and OlivoTests
         fails the build over a hex value, a font size or a corner radius typed in. `docs/design.md`
         is the authority, and this is the screen that settled those keys — it was the first to need
         them, so every screen after this one uses these names rather than proposing its own.

         Which controls are live is not decided here either. Every one of them is set from a
         RecorderScreen in the code-behind, which is the one thing that answers that question and
         the one thing a build agent can run.

         The whole screen in two halves: what the next meeting will record, above, and the meetings
         already recorded, below. One window and not two, because the second is what somebody comes
         back to the application for and a list behind a button is a list nobody opens. The drawer
         raises itself to the whole window, at which point the half above travels out of the way
         rather than vanishing — 300 ms, accelerating out, and nothing at all on a machine that
         asked Windows for no animation. How long that is worth is Movement's, in a project a build
         agent runs against both answers; what moves is ScreenMotion's.

         The raise is never refused, a meeting being recorded included, and it costs nothing
         because the strip below the card travels the other way as the half leaves. What a meeting
         under way is doing, and the press that stops it, are on screen whichever of the two
         arrangements the window is in. What is not on the strip is what nobody watches from the
         list: the two meters, and pause. -->

    <!-- Papel, and opaque. `docs/design.md` §And five things this application is not: never mica or
         acrylic, because a translucent window is one where nothing weighs anything. What was here
         was the platform's Mica backdrop. -->
    <Grid
        Background="{StaticResource PaperBrush}"
        Padding="{StaticResource ScreenPadding}"
        RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The application saying which application it is, which every artboard opens with. The
             mark and the name are the one thing `docs/design.md` §The artboards and this page calls
             deliberately unfinished, so what is drawn here is the placeholder those artboards
             carry, in one place for whoever draws the real one.

             **There is no settings gear**, and that is a decision rather than a piece left out.
             Every artboard draws a 34×34 gear at the right of this row and there is no settings
             screen behind it — #108 owns that screen and it is not built. Of the three answers, a
             live gear that opens nothing is the one this repository refuses outright; a disabled
             one says *not answerable just now*, which is what disabled means everywhere else in
             this application and is a lie here, since nothing about the state of the screen is
             stopping it; and explaining it in a line under it is what §The rules the design imposes
             forbids in as many words. So the row is drawn without it, and #108 puts it in the place
             this row already leaves for it. -->
        <Grid x:Name="TheApplication" Grid.Row="0" ColumnSpacing="11" Margin="6,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Drawn on the artboards' own 24-unit box inside a Viewbox rather than as two paths
                 each stretched to its own bounds, which would scale the two arcs independently and
                 pull the mark apart. -->
            <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path
                        Data="M8 7a7 7 0 0 0 0 10"
                        Stroke="{StaticResource InkBrush}"
                        StrokeThickness="2.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <Path
                        Data="M14.5 5a9.5 9.5 0 0 1 0 14"
                        Stroke="{StaticResource OliveBrush}"
                        StrokeThickness="2.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind In(loc:UiTexts.TheApplicationsName)}"
                Style="{StaticResource SectionText}" />
        </Grid>

        <!-- What the next meeting will record, on tarjeta. A card and not a stack of controls on
             the paper: `docs/design.md` §Two colours and nothing else has the window as papel and
             a block laid on it as tarjeta, and every artboard of this screen draws this half as one
             card with the meetings below it on the paper. -->
        <Border
            x:Name="RecordingCard"
            Grid.Row="1"
            Style="{StaticResource Card}"
            Padding="{StaticResource LargeCardPadding}">
            <StackPanel Spacing="18">
            <!-- What the next meeting will record and the presses that run it. It goes as one
                 thing while the meeting is being saved, because none of it is answerable then:
                 every control in it is dead, and a dead screen headed "record a meeting" over a
                 meeting being saved is a window that looks like it lost the one it just had. -->
            <StackPanel x:Name="TheNextMeeting" Spacing="18">
                <!-- The screen's title, and at its right the two things that are true of the
                     meeting as a whole rather than of one channel: what will be spoken in it, and
                     what will transcribe it. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind In(loc:UiTexts.RecordAMeeting)}"
                        Style="{StaticResource ScreenTitleText}" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <!-- The meeting's language and not the one the application is read in. The
                             two answer different questions and this is the one about the meeting,
                             which is why it is on this card and the other is below with the rest of
                             what is true of the install.

                             The line that used to explain it is gone. `docs/design.md` §The rules
                             the design imposes: a screen gets one sentence and only where something
                             failed, and **if an option needs a line explaining it, its name is
                             wrong** — *Idioma de la reunión* does not need one. What names it to a
                             screen reader is its automation name, because the pill carries no
                             header — and its placeholder says the same words, because this is the
                             one picker on the screen with nothing beside it: the two on the
                             channels carry a chip and a role, and on a fresh install this one
                             opens with nothing chosen and would otherwise be an empty box under a
                             status line telling somebody to choose what will be spoken. -->
                        <ComboBox
                            x:Name="SpokenPicker"
                            MinWidth="180"
                            Style="{StaticResource DropDown}"
                            PlaceholderText="{x:Bind In(loc:UiTexts.WhatWillBeSpoken)}"
                            AutomationProperties.Name="{x:Bind In(loc:UiTexts.WhatWillBeSpoken)}"
                            SelectionChanged="OnSpokenChosen" />

                        <!-- What transcribes the meeting. #97 settled that it is **shown here and
                             changed in the settings**, so it is the pill without the chevron: the
                             chevron is what says there is a list under a thing, and there is no
                             list here. The settings screen is #108's.

                             It is a constant in the catalogue and not something read off a
                             transcription: nothing in `src/` names a model yet, and this is the
                             engine `CLAUDE.md` and `docs/reference-behaviour.md` both say this
                             application transcribes with. When a request exists it is what this
                             reads. -->
                        <Border Style="{StaticResource Pill}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind In(loc:UiTexts.TheEngineThatTranscribes)}"
                                Style="{StaticResource BodyText}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Two channels, each with its picker over its own meter, split by a 1px rule.
                     `docs/design.md` §Where it goes: the meter is pinned to the control that
                     chooses its source — pick, look, pick the next one — and separating them turns
                     the answer into a memory test. That is the case of the three processes called
                     Teams, and the two pickers in one row over two meters in another was exactly
                     the arrangement that case defeats.

                     A rule and not a third surface. The same section: where a card genuinely holds two
                     things, a 1px rule separates them, because a third tint at the same lightness
                     as the paper is depth as decoration.

                     The channels are two and they are fixed: channel 0 is the others, channel 1 is
                     you. This is never a list. Everything in it is dead the moment a recording
                     starts — changing the microphone half way through is not a thing the engine can
                     do, so it is not a thing this screen offers. -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:ChannelStrip
                        x:Name="TheOthers"
                        Grid.Column="0"
                        Chose="OnSourceChosen" />

                    <Border
                        Grid.Column="1"
                        Width="1"
                        Background="{StaticResource LineBrush}" />

                    <local:ChannelStrip
                        x:Name="Mine"
                        Grid.Column="2"
                        Chose="OnMicrophoneChosen" />
                </Grid>

                <!-- The five lines a narrator is told about used to be here, each under the meter
                     whose channel it is about. They are not any more, and #204 is why: this half
                     travels out of the way when the meetings take the window, a collapsed element
                     is not in the automation tree at all, and a fault line that goes with it
                     announces nothing at the moment it has something to say. They are below the
                     card now, in the row that is on screen in both arrangements — where each says
                     which channel it is about in its own words, which is what the column under a
                     meter was saying and the sentence was already saying too. -->

                <!-- The whole-machine offer used to be here and is now below the card, for the
                     reason the five fault lines are: it appears while a meeting is running, which
                     is exactly when this half may have travelled out of the way, and an offer
                     nobody can see or reach is a recording of an hour of silence the application
                     did notice. -->

                <!-- The foot: the neutral answers on the left, the act on the right. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <!-- When the meeting gets transcribed. #97 settled that this is chosen
                             here, per meeting, as the two-way the artboard draws — and **nothing
                             in this application transcribes during a recording**, so the choice
                             has one answer and *Al terminar* is what happens to every meeting.

                             So it is the pill and not the trough, which is the same shape and the
                             same reason as the engine beside the title: a value that is true here
                             and settled elsewhere. Drawn as the two-way it would be the page's own
                             spec for a **live** control — trough, chosen half in papel at weight
                             500 — with nothing behind it: somebody presses *En vivo*, nothing
                             happens, no line appears, and they record an hour believing it is
                             being transcribed as they speak. Every other control on this card that
                             cannot be pressed is visibly dead; a two-way that looked alive would be
                             the one thing here that lies, and it would spend the trough's meaning
                             on a screen where it means the opposite. The card that makes live
                             transcription real is the one that brings the trough. -->
                        <Border Style="{StaticResource Pill}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind In(loc:UiTexts.TranscribedAtTheEnd)}"
                                Style="{StaticResource BodyText}" />
                        </Border>

                        <!-- The neutral press on this card: it opens no question and answers none,
                             it asks the machine what it has again. -->
                        <Button
                            x:Name="RefreshTheMachineButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource ButtonAtTheMargin}"
                            Click="OnRefreshTheMachine"
                            Content="{x:Bind In(loc:UiTexts.RefreshTheList)}" />
                    </StackPanel>

                    <!-- The one thing this screen is for takes the principal rank, and nothing else
                         on the screen does: `docs/design.md` §Controls says a screen has at most one
                         of the first. The three beside it steer a recording that is already running
                         rather than being what the screen is asking for, so they are normal. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PauseButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource NormalButtonOnCard}"
                            Click="OnPause"
                            Content="{x:Bind In(loc:UiTexts.Pause)}" />
                        <Button
                            x:Name="ResumeButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource NormalButtonOnCard}"
                            Click="OnResume"
                            Content="{x:Bind In(loc:UiTexts.Resume)}" />
                        <Button
                            x:Name="StopButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource NormalButtonOnCard}"
                            Click="OnStop"
                            Content="{x:Bind In(loc:UiTexts.Stop)}" />
                        <!-- The words and nothing else, and the dot the artboards draw on it is
                             deliberately not here. Built as a panel it cost two things worth more
                             than a glyph: the button's automation name, which is its content and
                             which a panel leaves empty, and the whole of its dead state — the fill
                             and the ink of a dead button are the platform's, and a circle and a
                             line of text carrying papel of their own stayed papel on top of it,
                             which is what a probe photographed. Colour is information here and
                             never decoration, and a dot that cannot be dimmed with the button it is
                             on is decoration that lies. -->
                        <Button
                            x:Name="RecordButton"
                            Style="{StaticResource PrincipalActButton}"
                            Click="OnRecord"
                            Content="{x:Bind In(loc:UiTexts.Record)}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Saving the meeting: the state the screen is in between stop and the meeting being
                 there. It is a state and not a moment — for a long meeting the spools take minutes
                 to become a recording — so it has a heading of its own and the steps of the save
                 under it. There is no notice about leaving the application alone, deliberately: a
                 save the process did not survive leaves the spools recovery already offers.

                 The steps are built in the code-behind and not templated here, for the reason the
                 meeting cards are: which of them exist is an answer, not a layout. What decides it
                 is SavingTheMeeting, in a project a build agent can run.

                 It says what the save is doing and never how long the meeting was. The length is
                 not known here — it comes out of pouring the spools onto a timeline, which is most
                 of what this state is waiting for — so a number beside this heading could only be
                 a guess, standing seconds before the report states the answer. One meeting, one
                 length, said once. -->
            <StackPanel x:Name="SavingCard" Spacing="12" Visibility="Collapsed">
                <TextBlock
                    Text="{x:Bind In(loc:UiTexts.SavingTheMeeting)}"
                    Style="{StaticResource ScreenTitleText}" />

                <StackPanel x:Name="SavingSteps" Spacing="8" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- How long the meeting has been going, and the biggest thing on the screen while one
                 is: it is what somebody glances up at to know where the meeting has got to. On
                 screen for exactly as long as the meters are, paused included, and answered by
                 RecordingClock in a project a build agent can run rather than decided here.

                 The stopwatch rank, and the only thing on any screen set at 62. It is also the one
                 thing `docs/design.md` §What never moves names outright: a number that animates
                 between two values is unreadable at exactly the moment somebody is reading it.

                 Not a live region, and that is a decision rather than an omission. It changes
                 every second, so announcing it would talk over every line beside it — including
                 the ones about a device dying, which are the only things on this screen worth
                 interrupting somebody for.

                 HelpText and not Name, which on a TextBlock are not two ways of saying the same
                 thing: a TextBlock's automation name is its own text, and setting Name replaces it
                 rather than labelling it — so the biggest number on the screen would be read out
                 as the words "how long the meeting has been running" and never as a length. A
                 meter labels itself that way because the bar carries the name; this has nothing
                 but its text. -->
            <TextBlock
                x:Name="TheClock"
                Style="{StaticResource StopwatchText}"
                Visibility="Collapsed"
                AutomationProperties.HelpText="{x:Bind In(loc:UiTexts.HowLongTheMeetingHasBeenRunning)}" />

            </StackPanel>
        </Border>

        <!-- Outside the half above, and bounded rather than left to take what is going. Outside
             because everything in it is written while the room below may have the whole window,
             and something that went with the recorder would be a screen saying nothing at the
             moment it had something to say. Bounded because the meetings own the room that is
             left, and a report that grew into it would push the list off the screen a line at a
             time.

             That was already the reason the identity row, the corpus line and the report are here,
             and it is #204's reason for everything above them: the strip, the five lines a
             narrator is told about, and the offer to record the whole machine. One row and not a
             second one beside it — a row that is empty in the state this window opens in still
             costs the grid its spacing on both sides. -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="6,0,6,0">
            <!-- The strip, which is what says what a meeting under way is doing while the room
                 below has the window. `docs/design/MainAbierto` draws it: the state word in olivo,
                 then how long the meeting has been running, what channel 0 is following and which
                 microphone is on it, as one line of data.

                 It is the recorder half's stand-in and never a second opinion beside it. The two
                 are never both on screen and neither reads the recording for itself: which one is
                 up, what it says and whether stop is live are all RecorderScreen's, in a project a
                 build agent runs, and the number on it is the same RecordingClock the stopwatch
                 above is drawn from. Two places asking a recording how long it had been going was
                 the drift this card was written not to create.

                 Tarjeta, like the card it stands in for, and the same corner. Its two texts are
                 set in the code-behind rather than bound here for the reason the drawer's own
                 button is: the state word changes without the language changing, and the line
                 beside it is data — a length, a program and a device, which read the same in every
                 language.

                 Stop and not the three. It is the one press ISC-172 is about and the one that
                 cannot wait for somebody to lower the list; pausing can. `MainAbierto` draws
                 *Detener* on the strip and no other press, which is what this is. -->
            <!-- The word it says is the meeting's own state and is deliberately not disabled with
                 the press beside it: the press goes dead the moment stop is pressed and the word
                 keeps saying what the save is doing, which is the whole of why it is there. -->
            <Border x:Name="TheStrip" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="StripSays"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionText}"
                        Foreground="{StaticResource OliveBrush}" />

                    <TextBlock
                        x:Name="StripLine"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource DataText}" />

                    <Button
                        x:Name="StripStopButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource NormalButtonOnCard}"
                        Click="OnStop"
                        Content="{x:Bind In(loc:UiTexts.Stop)}" />
                </Grid>
            </Border>

            <!-- The five lines a narrator is told about the moment something goes wrong with a
                 device. They are here rather than under the meters they are about because this row
                 does not travel and the recorder half does: a collapsed element is not in the
                 automation tree at all, so a fault line that went with the recorder would announce
                 nothing at exactly the moment it had something to say. Each already names the
                 channel it is about in its own words, so standing under a meter was saying a
                 second time what the sentence says.

                 Their words are set in the code-behind and never bound here: a line bound in the
                 XAML is set once while it is collapsed and never changes again, which is a live
                 region that announces nothing. MainWindow.Tell is what says these and why, and
                 LiveRegionTests fails if one is bound here or never told. -->
            <!-- A device dying is an event and not something to find by looking.

                 Channel 0 gets the line and no press, and that is the engine's answer rather than
                 a gap: both ways of obtaining channel 0 carry a sequence on, and a program refuses
                 to be opened under one, so there is no *Reintentar* to make for it.
                 `CaptureSession.OpenTheMicrophoneAgain` says it in full. What channel 0 has is
                 *Grabar toda la máquina*, which is the offer further down this row. -->
            <TextBlock
                x:Name="OthersStopped"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource PeakBrush}"
                AutomationProperties.LiveSetting="Assertive"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <!-- A channel that changed what it is on mid meeting, which is an event for the same
                 reason: the picker on the card goes on saying what was chosen, and what the
                 recording holds from here on is another source. This is the one thing that says
                 so, which is why the meter no longer repeats what it is capturing in grey. -->
            <TextBlock
                x:Name="OthersMoved"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource PeakBrush}"
                AutomationProperties.LiveSetting="Assertive"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <!-- Told, not bound, for the reason channel 0's line says. -->
            <TextBlock
                x:Name="MineStopped"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource PeakBrush}"
                AutomationProperties.LiveSetting="Assertive"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- The act on that line, and it is a sibling of it rather than a row around the two.
                 `docs/design/Fallo` draws *Reintentar* under the sentence, which is what this is —
                 but the reason it is not a Grid holding both is the lesson #204 was written about
                 and this nearly repeated: a collapsed element is not in the automation tree, so a
                 live region inside a container the code-behind collapses is told its words into
                 nothing on the one frame it exists for. Nothing may stand between one of these
                 lines and the row, and LiveRegionTests now fails if anything does.

                 *Reintentar* is the act, which `docs/design.md` §Fallo decides in as many words: a
                 source that is alive and silent is answered by pointing somewhere else, and a
                 device that stopped responding is answered by trying that same device again.
                 *Cambiar* is on that page too, as the neutral press on the left rather than the
                 answer, which is what the artboard draws beside this one. -->
            <Button
                x:Name="MineTryAgainButton"
                HorizontalAlignment="Left"
                Style="{StaticResource NormalButtonOnPaper}"
                Visibility="Collapsed"
                Click="OnTryTheMicrophoneAgain"
                Content="{x:Bind In(loc:UiTexts.TryTheMicrophoneAgain)}" />
            <!-- Told, not bound, for the reason channel 0's line says. -->
            <TextBlock
                x:Name="MineMoved"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource PeakBrush}"
                AutomationProperties.LiveSetting="Assertive"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <!-- True of both channels at once, so it sits under both rather than beside either.
                 Told, not bound, for the reason the four above are. -->
            <TextBlock
                x:Name="HeardTwice"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource PeakBrush}"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- The offer, and it is not on screen until the recording has made it. That is the
                 whole of the consent here: there is nothing to press early, so nothing pressed
                 early can be spent on it.

                 Here rather than on the card for the reason the five lines above are, and it is
                 the one of the six that is a press: it appears while a meeting is running, which
                 is exactly when the card may have travelled out of the way, and an offer nobody
                 can see or reach is the recording of an hour of silence the application did
                 notice. It is not on the strip either — the strip is the one thing that stands in
                 for the card, and a notice with an act on it is not a line on a strip.

                 Not pico, and `docs/design.md`'s `NadaLlego` says why in as many words: taking
                 the whole machine costs nothing and loses nothing. It is the act on a
                 notice, and an act on a notice takes the normal rank. A notice's act sits on
                 the right of it, which is the grammar every row on every screen keeps. -->
            <Grid x:Name="WholeMachineOffer" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind In(loc:UiTexts.NothingCameFromThatProgram)}"
                    Style="{StaticResource BodyText}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="WholeMachineButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource NormalButtonOnPaper}"
                    Click="OnRecordTheWholeMachine"
                    Content="{x:Bind In(loc:UiTexts.RecordTheWholeMachine)}" />
            </Grid>

            <!-- Who is using the application, beside where their meetings are kept: both are
                 answers about this install rather than about the next meeting, which is why they
                 are here and not up on the card. It is one field and one press whether it is
                 being answered for the first time or corrected afterwards — the asking is the
                 sentence under it, which is on screen exactly while nobody has answered.

                 It lives here until the settings screen exists, and then it moves there with the
                 language and this line: #108 is the card, and the row it is built around is this
                 one. The affiliation the design asks about is not here and is not missing —
                 `docs/design.md` says the first screen of an application is not where somebody
                 enumerates their jobs, and the `Persona` dialogue is where one is added. -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="WhoIsUsingThisBox"
                        MinWidth="240"
                        Style="{StaticResource TypedField}"
                        Header="{x:Bind In(loc:UiTexts.WhoIsUsingTheApplication)}"
                        TextChanged="OnWhoIsUsingThisTyped" />
                    <Button
                        x:Name="WhoIsUsingThisButton"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource NormalButtonOnPaper}"
                        Click="OnKeepWhoIsUsingThis"
                        Content="{x:Bind In(loc:UiTexts.Save)}" />

                    <!-- The language the application is **read** in, which is the other of the two
                         language questions on this screen and the one that is not about the next
                         meeting. It is here rather than on the card for the reason the row it sits
                         in is, and it goes to the settings with that row when #108 builds them.

                         Its label is beside it and not over it: a picker is a pill now and a pill
                         carries no header, so what it chooses is said as text. That text is also
                         what a screen reader is given, by name. -->
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,7"
                        Text="{x:Bind In(loc:UiTexts.Language)}"
                        Style="{StaticResource BodyText}"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox
                        x:Name="LanguagePicker"
                        MinWidth="150"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource DropDown}"
                        AutomationProperties.Name="{x:Bind In(loc:UiTexts.Language)}"
                        SelectionChanged="OnLanguageChosen" />
                </StackPanel>

                <!-- Left and not merely bounded. A `MaxWidth` on a block that stretches centres it,
                     so this sentence stood in the middle of a window nothing else on the row was
                     under — which a probe photographed. -->
                <TextBlock
                    x:Name="NobodyHasSaidYet"
                    HorizontalAlignment="Left"
                    Text="{x:Bind In(loc:UiTexts.NobodyHasSaidWhoIsUsingThis)}"
                    Style="{StaticResource BodyText}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap"
                    MaxWidth="640"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Where the meetings go, and which folder was refused when there is nowhere. Outside
                 the half above for the reason the report below it is: the drawer may take the
                 window while there is no corpus — nothing is being recorded then and nothing can
                 be — and this is the only line in the application that says which refusal it was.
                 The drawer's own line says the corpus could not be opened and sends somebody here
                 for why, so a screen that let this go with the recorder would be answering that
                 with an empty window.

                 A sentence, and so the body rank in a quieter ink. The path inside it is data and
                 the line around it is not — `docs/design.md` §Type: text never goes in mono, and a
                 number that is part of a sentence is text. Set at the data rank this read as a
                 whole line of code, which is what mono says about anything it is given. -->
            <TextBlock
                x:Name="CorpusText"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="180">
                <TextBlock
                    x:Name="OutputText"
                    Style="{StaticResource BodyText}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>

        <local:MeetingsDrawer x:Name="Meetings" Grid.Row="3" Margin="6,0,6,0" />

        <!-- One meeting, read in the room the list was using. The same screen and not another
             window: a meeting is reached from the list and returns to it, and a second window
             would be one more thing to find again — which is the same argument that keeps the list
             itself out of one. Which of the two is on screen is answered in the code-behind, where
             the drawer already says which position it is in. -->
        <local:ReadingAMeeting x:Name="Reading" Grid.Row="3" Margin="6,0,6,0" Visibility="Collapsed" />

        <!-- Filing that meeting, in the same room again. A sub-screen of a sub-screen: it is
             reached from the meeting and returns to it, and the meeting keeps its recording —
             paused — for as long as this is up. -->
        <local:ClassifyingAMeeting x:Name="Classifying" Grid.Row="3" Margin="6,0,6,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="6,0,6,0">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Style="{StaticResource BodyText}"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="PackagingChecksButton"
                Style="{StaticResource ButtonAtTheMargin}"
                Click="OnOpenPackagingChecks"
                Content="{x:Bind In(loc:UiTexts.PackagingChecks)}" />
        </StackPanel>
    </Grid>
</Window>
