<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingTranscriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No literal on any property a person reads: every one of them names an entry in UiTexts,
         so `Bindings.Update()` after a language change is the whole of what re-reads this screen.
         MeetingTranscriber.App.Tests fails the build if a literal creeps back in. -->

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{x:Bind In(loc:UiTexts.PackagingChecks)}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind In(loc:UiTexts.PackagingChecksAreScaffolding)}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button x:Name="EnvironmentButton" Click="OnRunEnvironmentProbe" Content="{x:Bind In(loc:UiTexts.ChildEnvironmentCheck)}" />
            <Button x:Name="FileSystemButton" Click="OnRunFileSystemProbe" Content="{x:Bind In(loc:UiTexts.WritePathCheck)}" />
            <Button x:Name="SaveButton" Click="OnSaveReport" Content="{x:Bind In(loc:UiTexts.SaveReport)}" />
            <ComboBox
                x:Name="LanguagePicker"
                Header="{x:Bind In(loc:UiTexts.Language)}"
                SelectionChanged="OnLanguageChosen" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="OutputText"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                IsTextSelectionEnabled="True"
                TextWrapping="NoWrap" />
        </ScrollViewer>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7" />
    </Grid>
</Window>
