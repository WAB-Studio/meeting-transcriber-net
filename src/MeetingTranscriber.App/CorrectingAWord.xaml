<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeetingTranscriber.App.CorrectingAWord"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingTranscriber.App"
    xmlns:loc="using:MeetingTranscriber.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource Notice}"
    DefaultButton="Primary"
    Opened="OnOpened"
    PrimaryButtonClick="OnCorrect"
    Title="{x:Bind In(loc:UiTexts.FixAWord)}"
    PrimaryButtonText="{x:Bind In(loc:UiTexts.Save)}"
    CloseButtonText="{x:Bind In(loc:UiTexts.Cancel)}">

    <!-- Correcting one word where it is read — the third and last dialogue `docs/design.md`
         §Notices allows. Two screens open it, the meeting's own and the one that names voices, over
         a line of the transcript or a voice's quotation: a word that came out wrong is seen there,
         and a flow that sends somebody to another screen to type it loses the line they were on.

         It holds the word as it stands, a field for the word as it should be, and the choice the
         screen of every word that comes out wrong has of where the correction holds. Saving goes
         through `CorrectingWords.Correct` and nothing else, so a transcript is only ever said to
         be corrected by the one door that renders it again. -->
    <StackPanel Spacing="12" MinWidth="320">
        <StackPanel x:Name="TheWordAsWrittenLine" Spacing="2">
            <TextBlock
                Style="{StaticResource DataText}"
                Text="{x:Bind In(loc:UiTexts.HowItCameOutWritten)}" />
            <TextBlock x:Name="TheWordAsWritten" Style="{StaticResource TranscriptText}" />
        </StackPanel>

        <TextBox
            x:Name="TheWordAsItShouldBeBox"
            Style="{StaticResource TypedField}"
            TextChanged="OnTyped"
            Header="{x:Bind In(loc:UiTexts.TheWordAsItShouldBe)}" />

        <ComboBox
            x:Name="ScopeBox"
            MinWidth="180"
            Style="{StaticResource DropDown}" />

        <!-- In place of the field, over a word a correction already reaching the meeting wrote. -->
        <TextBlock
            x:Name="AlreadyCorrectedText"
            Style="{StaticResource BodyText}"
            Text="{x:Bind In(loc:UiTexts.AlreadyCorrected)}"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="DialogueStatusText"
            Style="{StaticResource BodyText}"
            Foreground="{ThemeResource PeakBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
