<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Package versions live here. A .csproj carries
       <PackageReference Include="..." /> with no Version. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Pinned to the 1.x line of Microsoft.Testing.Platform: xunit.v3 3.2.2 uses
         xunit.v3.core.mtp-v1, and from 18.1.0 onwards this extension jumps to MTP 2.x,
         which blows up with TypeLoadException. Can move once xunit.v3 4 is stable. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <!-- WASAPI capture and endpoint enumeration. The NAudio meta-package pulls MIDI, ASIO and
         WinMM along with it, and this application opens none of the three. -->
    <PackageVersion Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <!-- The UI probe's MCP server, and only that one. `.Core` and not `ModelContextProtocol`
         because the latter is the hosting and DI layer on top, and a hand-run tool with one
         mutable session and seven verbs has nothing to put in a container. The app's own MCP
         server is the other choice and pins the meta-package when it is built: docs/packages.md
         carries a row for each. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Transitive pin. Microsoft.Data.Sqlite 10.0.10 still asks for the 2.1.x bundle, whose
         native e_sqlite3 carries GHSA-2m69-gcr7-jv3q. The 3.x bundle is the fixed line. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- The legacy corpus is YAML. Nothing the application writes is. -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>