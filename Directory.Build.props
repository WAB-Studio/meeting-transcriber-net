<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Los warnings se compilan como errores en CI, con -warnaserror.
       En la máquina de desarrollo se ven y no frenan. -->

</Project>
