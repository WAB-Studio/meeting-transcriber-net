<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MeetingTranscriber.UiProbe</RootNamespace>
    <!-- Not because anything here is WPF. The Windows Desktop pack is where the two things this
         tool cannot do without live: `System.Windows.Automation`, the managed UI Automation
         client, and `PngBitmapEncoder`. Both ship in the runtime, so reading a window and writing
         a picture of it cost this repository no package reference at all. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
