<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>corpus-import</AssemblyName>
    <RootNamespace>MeetingTranscriber.CorpusImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MeetingTranscriber.Domain\MeetingTranscriber.Domain.csproj" />
    <ProjectReference Include="..\..\src\MeetingTranscriber.Infrastructure\MeetingTranscriber.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Python corpus is YAML. Nothing the application itself reads or writes is, which is
         why this reference is here and not in Infrastructure. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
