<Solution>
  <Folder Name="/src/">
    <!-- Deploy: without it F5 builds but does not deploy the MSIX, and no window opens. -->
    <Project Path="src/MeetingTranscriber.App/MeetingTranscriber.App.csproj">
      <Platform Project="x64" />
      <Deploy />
    </Project>
    <!-- Diagnosis, import, rebuild and recovery from a prompt. It calls the same services the
         app does: what it adds is argument parsing, a report and an exit code. -->
    <Project Path="src/MeetingTranscriber.Cli/MeetingTranscriber.Cli.csproj" />
    <!-- WASAPI, and what the two streams of one recording are. Referenced by the CLI and, when
         there is a window, by the application. -->
    <Project Path="src/MeetingTranscriber.Audio/MeetingTranscriber.Audio.csproj" />
    <Project Path="src/MeetingTranscriber.Domain/MeetingTranscriber.Domain.csproj" />
    <Project Path="src/MeetingTranscriber.Infrastructure/MeetingTranscriber.Infrastructure.csproj" />
    <!-- What the application says and what language it says it in. Outside the app because the
         Windows App SDK's module initializer makes anything living beside a window unloadable
         anywhere there is no window. -->
    <Project Path="src/MeetingTranscriber.Presentation/MeetingTranscriber.Presentation.csproj" />
    <Project Path="src/MeetingTranscriber.Processing/MeetingTranscriber.Processing.csproj" />
    <!-- Where a rule that needs more than one of the audio engine, the corpus and rendering
         lives, and what the application composes through: recording a meeting is where those
         halves meet. -->
    <Project Path="src/MeetingTranscriber.Recording/MeetingTranscriber.Recording.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <!-- Holds no test: the corpus on disk, the SQL helpers and the fixture inventory the suites
         share, so a third project that needs one references it rather than copying it. -->
    <Project Path="tests/MeetingTranscriber.Testing/MeetingTranscriber.Testing.csproj" />
    <!-- Reads the screens as source. It cannot reference the application and does not: loading
         the app's assembly outside a packaged host throws before the first assertion. -->
    <Project Path="tests/MeetingTranscriber.App.Tests/MeetingTranscriber.App.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Audio.Tests/MeetingTranscriber.Audio.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Cli.Tests/MeetingTranscriber.Cli.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Domain.Tests/MeetingTranscriber.Domain.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Infrastructure.Tests/MeetingTranscriber.Infrastructure.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Presentation.Tests/MeetingTranscriber.Presentation.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Processing.Tests/MeetingTranscriber.Processing.Tests.csproj" />
    <Project Path="tests/MeetingTranscriber.Recording.Tests/MeetingTranscriber.Recording.Tests.csproj" />
    <!-- Reads ISA.md and the source text under tests/, references no project at all: what it holds
         are rules about the repository rather than about a layer, so its gate belongs under none of
         them and can cover suites no reference from here could reach. -->
    <Project Path="tests/MeetingTranscriber.Isa.Tests/MeetingTranscriber.Isa.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <!-- Run by hand, in the solution so the build and the formatter still see it. -->
    <Project Path="tools/MeetingTranscriber.CorpusFixtures/MeetingTranscriber.CorpusFixtures.csproj" />
    <!-- Starts the application and presses what is on it. It needs a desktop somebody is logged
         into, so it is the one project here that is only ever run by hand. -->
    <Project Path="tools/MeetingTranscriber.UiProbe/MeetingTranscriber.UiProbe.csproj" />
  </Folder>
</Solution>
